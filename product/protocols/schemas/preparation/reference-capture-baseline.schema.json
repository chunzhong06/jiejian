{
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "const": 1,
      "default": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "baseline_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Sha256",
      "type": "string"
    },
    "capture_id": {
      "pattern": "^rpc_[0-9a-f]{32}$",
      "title": "Capture Id",
      "type": "string"
    },
    "collection": {
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
      "title": "Collection",
      "type": "string"
    },
    "fencing_token": {
      "minimum": 1,
      "title": "Fencing Token",
      "type": "integer"
    },
    "generation": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Generation",
      "type": "string"
    },
    "job_id": {
      "pattern": "^job_[0-9a-f]{32}$",
      "title": "Job Id",
      "type": "string"
    },
    "lease_owner": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Lease Owner",
      "type": "string"
    },
    "observed_at_us": {
      "minimum": 0,
      "title": "Observed At Us",
      "type": "integer"
    },
    "owner_identity_id": {
      "pattern": "^tid_[0-9a-f]{32}$",
      "title": "Owner Identity Id",
      "type": "string"
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "resource_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Resource Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "capture_id",
    "job_id",
    "fencing_token",
    "lease_owner",
    "request_hash",
    "baseline_sha256",
    "generation",
    "resource_id",
    "owner_identity_id",
    "collection",
    "observed_at_us"
  ],
  "title": "ReferenceCaptureBaseline",
  "type": "object"
}
