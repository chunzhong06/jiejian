{
  "$defs": {
    "ArtifactManifestReference": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^pai_[0-9a-f]{32}$",
          "title": "Asset Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "exclusiveMinimum": 0,
          "maximum": 4194304,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "sha256",
        "size"
      ],
      "title": "ArtifactManifestReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "pattern": "^bac_[0-9a-f]{32}$",
      "title": "Action Id",
      "type": "string"
    },
    "action_revision": {
      "minimum": 1,
      "title": "Action Revision",
      "type": "integer"
    },
    "asset_id": {
      "pattern": "^pai_[0-9a-f]{32}$",
      "title": "Asset Id",
      "type": "string"
    },
    "basis_id": {
      "pattern": "^pb_[0-9a-f]{64}$",
      "title": "Basis Id",
      "type": "string"
    },
    "created_at_us": {
      "minimum": 0,
      "title": "Created At Us",
      "type": "integer"
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactManifestReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operation_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Operation Id",
      "type": "string"
    },
    "origin": {
      "enum": [
        "UPLOAD",
        "REFERENCE_CAPTURE"
      ],
      "title": "Origin",
      "type": "string"
    },
    "owner_identity_id": {
      "pattern": "^tid_[0-9a-f]{32}$",
      "title": "Owner Identity Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "reference_capture_id": {
      "anyOf": [
        {
          "pattern": "^rpc_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Capture Id"
    },
    "resource_binding_id": {
      "pattern": "^res_[0-9a-f]{32}$",
      "title": "Resource Binding Id",
      "type": "string"
    },
    "resource_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Resource Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "PENDING",
        "COMPLETE",
        "INCOMPLETE",
        "CANCELLED"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "project_id",
    "operation_id",
    "action_id",
    "action_revision",
    "resource_binding_id",
    "resource_id",
    "owner_identity_id",
    "origin",
    "state",
    "created_at_us",
    "basis_id"
  ],
  "title": "ProofArtifactInput",
  "type": "object"
}
