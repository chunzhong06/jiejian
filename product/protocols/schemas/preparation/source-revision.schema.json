{
  "$defs": {
    "ManagedIdentityClaim": {
      "additionalProperties": false,
      "properties": {
        "application_role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Application Role",
          "type": "string"
        },
        "application_subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Application Subject Id",
          "type": "string"
        },
        "identity_id": {
          "pattern": "^tid_[0-9a-f]{32}$",
          "title": "Identity Id",
          "type": "string"
        },
        "request_path": {
          "maxLength": 512,
          "minLength": 2,
          "title": "Request Path",
          "type": "string"
        },
        "role_path": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Role Path",
          "type": "array"
        },
        "subject_path": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Subject Path",
          "type": "array"
        }
      },
      "required": [
        "identity_id",
        "application_subject_id",
        "request_path",
        "subject_path",
        "role_path",
        "application_role"
      ],
      "title": "ManagedIdentityClaim",
      "type": "object"
    },
    "ManagedProofSourceConfig": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^bac_[0-9a-f]{32}$",
          "title": "Action Id",
          "type": "string"
        },
        "action_revision": {
          "minimum": 1,
          "title": "Action Revision",
          "type": "integer"
        },
        "collection": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "title": "Collection",
          "type": "string"
        },
        "effect_id": {
          "pattern": "^bef_[0-9a-f]{32}$",
          "title": "Effect Id",
          "type": "string"
        },
        "identity_claims": {
          "items": {
            "$ref": "#/$defs/ManagedIdentityClaim"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Identity Claims",
          "type": "array"
        },
        "mappings": {
          "additionalProperties": {
            "items": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          "maxProperties": 16,
          "minProperties": 2,
          "propertyNames": {
            "enum": [
              "resource_id",
              "owner_id",
              "state",
              "version",
              "effect_count",
              "history_generation",
              "operation_id",
              "operation_resource_id",
              "operation_subject_id",
              "operation_before_version",
              "operation_after_version",
              "operation_state",
              "unfinished_effects",
              "title",
              "summary",
              "body"
            ]
          },
          "title": "Mappings",
          "type": "object"
        },
        "max_response_bytes": {
          "default": 262144,
          "maximum": 262144,
          "minimum": 1024,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "observation_identity_id": {
          "pattern": "^tid_[0-9a-f]{32}$",
          "title": "Observation Identity Id",
          "type": "string"
        },
        "protected_projection": {
          "default": [],
          "items": {
            "maxLength": 256,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*){0,7}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Protected Projection",
          "type": "array"
        },
        "read_scope_id": {
          "anyOf": [
            {
              "pattern": "^prs_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read Scope Id"
        },
        "relative_path_template": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Relative Path Template",
          "type": "string"
        },
        "resource_binding_id": {
          "pattern": "^res_[0-9a-f]{32}$",
          "title": "Resource Binding Id",
          "type": "string"
        },
        "source_contract_id": {
          "enum": [
            "TRANSACTION_HISTORY_V1",
            "RESOURCE_FIELDS_V1"
          ],
          "title": "Source Contract Id",
          "type": "string"
        },
        "source_files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Source Files",
          "type": "array"
        },
        "source_kind": {
          "const": "MANAGED_TRANSACTION_RECORDS",
          "default": "MANAGED_TRANSACTION_RECORDS",
          "title": "Source Kind",
          "type": "string"
        },
        "target_data_path": {
          "default": [
            "data"
          ],
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Target Data Path",
          "type": "array"
        },
        "target_operation_path": {
          "default": [
            "operation_id"
          ],
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Target Operation Path",
          "type": "array"
        },
        "target_owner_path": {
          "default": [
            "owner_id"
          ],
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Target Owner Path",
          "type": "array"
        },
        "target_resource_path": {
          "default": [
            "resource_id"
          ],
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Target Resource Path",
          "type": "array"
        },
        "timeout_us": {
          "default": 5000000,
          "maximum": 5000000,
          "minimum": 1000,
          "title": "Timeout Us",
          "type": "integer"
        }
      },
      "required": [
        "action_id",
        "action_revision",
        "effect_id",
        "observation_identity_id",
        "resource_binding_id",
        "relative_path_template",
        "mappings",
        "source_contract_id",
        "identity_claims",
        "collection"
      ],
      "title": "ManagedProofSourceConfig",
      "type": "object"
    },
    "ProofSourceConfig": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^bac_[0-9a-f]{32}$",
          "title": "Action Id",
          "type": "string"
        },
        "action_revision": {
          "minimum": 1,
          "title": "Action Revision",
          "type": "integer"
        },
        "effect_id": {
          "pattern": "^bef_[0-9a-f]{32}$",
          "title": "Effect Id",
          "type": "string"
        },
        "identity_claims": {
          "items": {
            "$ref": "#/$defs/SourceIdentityClaim"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Identity Claims",
          "type": "array"
        },
        "mappings": {
          "additionalProperties": {
            "items": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          "maxProperties": 16,
          "minProperties": 2,
          "propertyNames": {
            "enum": [
              "resource_id",
              "owner_id",
              "state",
              "version",
              "effect_count",
              "history_generation",
              "operation_id",
              "operation_resource_id",
              "operation_subject_id",
              "operation_before_version",
              "operation_after_version",
              "operation_state",
              "unfinished_effects",
              "title",
              "summary",
              "body"
            ]
          },
          "title": "Mappings",
          "type": "object"
        },
        "max_response_bytes": {
          "default": 262144,
          "maximum": 262144,
          "minimum": 1024,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "observation_identity_id": {
          "pattern": "^tid_[0-9a-f]{32}$",
          "title": "Observation Identity Id",
          "type": "string"
        },
        "read_scope_id": {
          "anyOf": [
            {
              "pattern": "^prs_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read Scope Id"
        },
        "relative_path_template": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Relative Path Template",
          "type": "string"
        },
        "resource_binding_id": {
          "pattern": "^res_[0-9a-f]{32}$",
          "title": "Resource Binding Id",
          "type": "string"
        },
        "source_contract_id": {
          "enum": [
            "SYNC_RESOURCE_HISTORY_V1",
            "OWNER_RESOURCE_VIEW_V1",
            "TRANSACTION_HISTORY_V1",
            "RESOURCE_FIELDS_V1"
          ],
          "title": "Source Contract Id",
          "type": "string"
        },
        "source_files": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Source Files",
          "type": "array"
        },
        "source_kind": {
          "const": "JSON_HTTP_RESOURCE",
          "default": "JSON_HTTP_RESOURCE",
          "title": "Source Kind",
          "type": "string"
        },
        "target_operation_path": {
          "default": [
            "operation_id"
          ],
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Target Operation Path",
          "type": "array"
        },
        "timeout_us": {
          "default": 5000000,
          "maximum": 5000000,
          "minimum": 1000,
          "title": "Timeout Us",
          "type": "integer"
        }
      },
      "required": [
        "action_id",
        "action_revision",
        "effect_id",
        "observation_identity_id",
        "resource_binding_id",
        "relative_path_template",
        "mappings",
        "source_contract_id",
        "identity_claims",
        "source_files"
      ],
      "title": "ProofSourceConfig",
      "type": "object"
    },
    "SourceIdentityClaim": {
      "additionalProperties": false,
      "properties": {
        "application_subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Application Subject Id",
          "type": "string"
        },
        "identity_id": {
          "pattern": "^tid_[0-9a-f]{32}$",
          "title": "Identity Id",
          "type": "string"
        }
      },
      "required": [
        "identity_id",
        "application_subject_id"
      ],
      "title": "SourceIdentityClaim",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis_id": {
      "pattern": "^pb_[0-9a-f]{64}$",
      "title": "Basis Id",
      "type": "string"
    },
    "client_name": {
      "maxLength": 80,
      "title": "Client Name",
      "type": "string"
    },
    "config": {
      "discriminator": {
        "mapping": {
          "JSON_HTTP_RESOURCE": "#/$defs/ProofSourceConfig",
          "MANAGED_TRANSACTION_RECORDS": "#/$defs/ManagedProofSourceConfig"
        },
        "propertyName": "source_kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ProofSourceConfig"
        },
        {
          "$ref": "#/$defs/ManagedProofSourceConfig"
        }
      ],
      "title": "Config"
    },
    "created_at_us": {
      "minimum": 0,
      "title": "Created At Us",
      "type": "integer"
    },
    "fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "default": "2",
      "enum": [
        "1",
        "2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "pattern": "^psr_[0-9a-f]{32}$",
      "title": "Source Id",
      "type": "string"
    },
    "submitted_via": {
      "enum": [
        "LOCAL_GUI",
        "MCP"
      ],
      "title": "Submitted Via",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "source_id",
    "revision",
    "config",
    "basis_id",
    "fingerprint",
    "submitted_via",
    "client_name",
    "created_at_us"
  ],
  "title": "ProofSourceRevision",
  "type": "object"
}
