{
  "$defs": {
    "DatabaseCapture": {
      "additionalProperties": false,
      "properties": {
        "connection_id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Connection Id",
          "type": "string"
        },
        "database": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Database",
          "type": "string"
        },
        "engine": {
          "enum": [
            "POSTGRESQL",
            "MYSQL"
          ],
          "title": "Engine",
          "type": "string"
        },
        "fields": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "host": {
          "const": "127.0.0.1",
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "namespace": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Namespace",
          "type": "string"
        },
        "owner_column": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Owner Column",
          "type": "string"
        },
        "password_env": {
          "pattern": "^JIEJIAN_DB_[A-Z0-9_]{1,64}$",
          "title": "Password Env",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1024,
          "title": "Port",
          "type": "integer"
        },
        "resource_column": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Resource Column",
          "type": "string"
        },
        "table": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Table",
          "type": "string"
        },
        "username": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "connection_id",
        "engine",
        "port",
        "database",
        "namespace",
        "username",
        "password_env",
        "table",
        "resource_column",
        "owner_column",
        "fields"
      ],
      "title": "DatabaseCapture",
      "type": "object"
    },
    "SqliteReadSelection": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "database_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Database Path",
          "type": "string"
        },
        "table": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Table",
          "type": "string"
        }
      },
      "required": [
        "database_path",
        "table",
        "columns"
      ],
      "title": "SqliteReadSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at_us": {
      "minimum": 0,
      "title": "Created At Us",
      "type": "integer"
    },
    "databases": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DatabaseCapture"
      },
      "maxItems": 4,
      "title": "Databases",
      "type": "array"
    },
    "document_type": {
      "const": "jiejian.source-read-scope",
      "default": "jiejian.source-read-scope",
      "title": "Document Type",
      "type": "string"
    },
    "identity_ids": {
      "items": {
        "pattern": "^tid_[0-9a-f]{32}$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Identity Ids",
      "type": "array"
    },
    "max_response_bytes": {
      "maximum": 262144,
      "minimum": 1024,
      "title": "Max Response Bytes",
      "type": "integer"
    },
    "origin": {
      "title": "Origin",
      "type": "string"
    },
    "path_templates": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Path Templates",
      "type": "array"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "resource_binding_ids": {
      "items": {
        "pattern": "^res_[0-9a-f]{32}$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Resource Binding Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_id": {
      "pattern": "^prs_[0-9a-f]{32}$",
      "title": "Scope Id",
      "type": "string"
    },
    "sqlite": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SqliteReadSelection"
      },
      "maxItems": 4,
      "title": "Sqlite",
      "type": "array"
    },
    "timeout_us": {
      "maximum": 5000000,
      "minimum": 1000,
      "title": "Timeout Us",
      "type": "integer"
    }
  },
  "required": [
    "scope_id",
    "project_id",
    "origin",
    "path_templates",
    "identity_ids",
    "resource_binding_ids",
    "max_response_bytes",
    "timeout_us",
    "created_at_us"
  ],
  "title": "SourceReadScope",
  "type": "object"
}
