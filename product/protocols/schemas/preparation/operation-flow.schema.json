{
  "$defs": {
    "ApiSourceReference": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "pattern": "^req_[0-9a-f]{32}$",
          "title": "Item Id",
          "type": "string"
        },
        "request_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Fingerprint",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "source_id": {
          "pattern": "^src_[0-9a-f]{32}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "revision",
        "item_id",
        "request_fingerprint"
      ],
      "title": "ApiSourceReference",
      "type": "object"
    },
    "BaselineIntegrityMode": {
      "enum": [
        "EXACT_RESTORE",
        "NORMALIZED_EQUIVALENCE"
      ],
      "title": "BaselineIntegrityMode",
      "type": "string"
    },
    "BaselineProjection": {
      "additionalProperties": false,
      "properties": {
        "expected_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Fingerprint"
        },
        "integrity_mode": {
          "$ref": "#/$defs/BaselineIntegrityMode",
          "default": "EXACT_RESTORE"
        },
        "logical_resource_handle": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
          "title": "Logical Resource Handle",
          "type": "string"
        },
        "normalization_version": {
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$",
          "title": "Normalization Version",
          "type": "string"
        },
        "projection_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
          "title": "Projection Id",
          "type": "string"
        },
        "projection_version": {
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$",
          "title": "Projection Version",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "projection_id",
        "logical_resource_handle",
        "normalization_version",
        "projection_version"
      ],
      "title": "BaselineProjection",
      "type": "object"
    },
    "EmptyBody": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "EMPTY",
          "default": "EMPTY",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "EmptyBody",
      "type": "object"
    },
    "FormUrlEncodedBody": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HttpParameter"
          },
          "maxItems": 128,
          "title": "Fields",
          "type": "array"
        },
        "kind": {
          "const": "FORM_URLENCODED",
          "default": "FORM_URLENCODED",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "FormUrlEncodedBody",
      "type": "object"
    },
    "FrozenEnvironment": {
      "additionalProperties": false,
      "properties": {
        "deployment_label": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deployment Label"
        },
        "deployment_verification": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Deployment Verification",
          "type": "string"
        },
        "environment_id": {
          "pattern": "^env_[0-9a-f]{32}$",
          "title": "Environment Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/WebTargetScope"
        }
      },
      "required": [
        "environment_id",
        "revision",
        "name",
        "target"
      ],
      "title": "FrozenEnvironment",
      "type": "object"
    },
    "HttpEntityEvidence": {
      "additionalProperties": false,
      "properties": {
        "effect_id": {
          "pattern": "^bef_[0-9a-f]{32}$",
          "title": "Effect Id",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/HttpEntityQuery"
        }
      },
      "required": [
        "effect_id",
        "query"
      ],
      "title": "HttpEntityEvidence",
      "type": "object"
    },
    "HttpEntityQuery": {
      "additionalProperties": false,
      "properties": {
        "data_path": {
          "default": "$",
          "pattern": "^\\$(?:\\.[A-Za-z_][A-Za-z0-9_]{0,63}){0,8}$",
          "title": "Data Path",
          "type": "string"
        },
        "owner_path": {
          "default": "$.owner_id",
          "pattern": "^\\$(?:\\.[A-Za-z_][A-Za-z0-9_]{0,63}){1,8}$",
          "title": "Owner Path",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/HttpRequestTemplate"
        },
        "resource_path": {
          "default": "$.id",
          "pattern": "^\\$(?:\\.[A-Za-z_][A-Za-z0-9_]{0,63}){1,8}$",
          "title": "Resource Path",
          "type": "string"
        }
      },
      "required": [
        "request"
      ],
      "title": "HttpEntityQuery",
      "type": "object"
    },
    "HttpOutcomeClassifier": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HttpPredicate"
          },
          "maxItems": 128,
          "title": "Accepted",
          "type": "array"
        },
        "completion_binding": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Binding"
        },
        "denied": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HttpPredicate"
          },
          "maxItems": 128,
          "title": "Denied",
          "type": "array"
        }
      },
      "title": "HttpOutcomeClassifier",
      "type": "object"
    },
    "HttpParameter": {
      "additionalProperties": false,
      "description": "受控 Query/Header/Form 字段；字段值只能是 literal 或已声明 Slot。",
      "properties": {
        "literal": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literal"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.~\\-]+$",
          "title": "Name",
          "type": "string"
        },
        "slot_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot Id"
        }
      },
      "required": [
        "name"
      ],
      "title": "HttpParameter",
      "type": "object"
    },
    "HttpPredicate": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "header_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Name"
        },
        "json_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Path"
        },
        "kind": {
          "$ref": "#/$defs/HttpPredicateKind"
        },
        "literal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literal"
        },
        "redirect_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redirect Path"
        },
        "selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selector"
        },
        "statuses": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "maxItems": 32,
          "title": "Statuses",
          "type": "array"
        },
        "values": {
          "default": [],
          "items": {},
          "maxItems": 32,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "HttpPredicate",
      "type": "object"
    },
    "HttpPredicateKind": {
      "enum": [
        "STATUS_IN",
        "JSON_PATH_EXISTS",
        "JSON_PATH_EQUALS",
        "JSON_PATH_IN",
        "HEADER_EXISTS",
        "HEADER_EQUALS",
        "REDIRECT_PATH_MATCHES",
        "HTML_SELECTOR_EXISTS",
        "HTML_ATTRIBUTE_EQUALS",
        "BODY_CONTAINS_LITERAL"
      ],
      "title": "HttpPredicateKind",
      "type": "string"
    },
    "HttpRequestTemplate": {
      "additionalProperties": false,
      "description": "单请求受控模板；不接受 URL、脚本、任意文件或保留认证头。",
      "properties": {
        "body": {
          "discriminator": {
            "mapping": {
              "EMPTY": "#/$defs/EmptyBody",
              "FORM_URLENCODED": "#/$defs/FormUrlEncodedBody",
              "JSON": "#/$defs/JsonBody",
              "MULTIPART": "#/$defs/MultipartBody"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/EmptyBody"
            },
            {
              "$ref": "#/$defs/JsonBody"
            },
            {
              "$ref": "#/$defs/FormUrlEncodedBody"
            },
            {
              "$ref": "#/$defs/MultipartBody"
            }
          ],
          "title": "Body"
        },
        "headers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HttpParameter"
          },
          "maxItems": 128,
          "title": "Headers",
          "type": "array"
        },
        "input_slots": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueSlot"
          },
          "maxItems": 128,
          "title": "Input Slots",
          "type": "array"
        },
        "method": {
          "enum": [
            "GET",
            "PATCH",
            "POST",
            "PUT",
            "DELETE",
            "HEAD"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^/[A-Za-z0-9_./{}~:@%+\\-]*$",
          "title": "Path",
          "type": "string"
        },
        "query": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HttpParameter"
          },
          "maxItems": 128,
          "title": "Query",
          "type": "array"
        },
        "response_extractors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResponseExtractor"
          },
          "maxItems": 128,
          "title": "Response Extractors",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "method",
        "path"
      ],
      "title": "HttpRequestTemplate",
      "type": "object"
    },
    "HttpWorkflowBinding": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
          "title": "Action Id",
          "type": "string"
        },
        "baseline_projections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BaselineProjection"
          },
          "maxItems": 128,
          "title": "Baseline Projections",
          "type": "array"
        },
        "logical_resource_slots": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LogicalResourceSlot"
          },
          "maxItems": 128,
          "title": "Logical Resource Slots",
          "type": "array"
        },
        "reset_strategy": {
          "discriminator": {
            "mapping": {
              "NOT_REQUIRED": "#/$defs/ResetNotRequiredStrategy",
              "RESET_ENDPOINT": "#/$defs/ResetEndpointStrategy",
              "SNAPSHOT_PROVIDER": "#/$defs/SnapshotProviderResetStrategy",
              "UNIQUE_RESOURCE_WORKFLOW": "#/$defs/UniqueResourceWorkflowResetStrategy"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ResetEndpointStrategy"
            },
            {
              "$ref": "#/$defs/UniqueResourceWorkflowResetStrategy"
            },
            {
              "$ref": "#/$defs/SnapshotProviderResetStrategy"
            },
            {
              "$ref": "#/$defs/ResetNotRequiredStrategy"
            }
          ],
          "title": "Reset Strategy"
        },
        "source_flow_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
          "title": "Source Flow Id",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/HttpWorkflowStep"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "target_step_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
          "title": "Target Step Id",
          "type": "string"
        },
        "workflow_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workflow Fingerprint"
        },
        "workflow_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "workflow_id",
        "source_flow_id",
        "action_id",
        "steps",
        "target_step_id"
      ],
      "title": "HttpWorkflowBinding",
      "type": "object"
    },
    "HttpWorkflowStep": {
      "additionalProperties": false,
      "properties": {
        "classifier": {
          "$ref": "#/$defs/HttpOutcomeClassifier"
        },
        "depends_on_step_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Depends On Step Ids",
          "type": "array"
        },
        "failure_policy": {
          "$ref": "#/$defs/WorkflowFailurePolicy",
          "default": "INCONCLUSIVE"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "identity_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Identity Id",
          "type": "string"
        },
        "input_slots": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueSlot"
          },
          "maxItems": 128,
          "title": "Input Slots",
          "type": "array"
        },
        "output_extractors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResponseExtractor"
          },
          "maxItems": 128,
          "title": "Output Extractors",
          "type": "array"
        },
        "purpose": {
          "$ref": "#/$defs/WorkflowStepPurpose"
        },
        "request_template": {
          "$ref": "#/$defs/HttpRequestTemplate"
        }
      },
      "required": [
        "id",
        "purpose",
        "identity_id",
        "request_template"
      ],
      "title": "HttpWorkflowStep",
      "type": "object"
    },
    "JsonBody": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "JSON",
          "default": "JSON",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "JsonBody",
      "type": "object"
    },
    "LogicalResourceSlot": {
      "additionalProperties": false,
      "properties": {
        "logical_resource_handle": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
          "title": "Logical Resource Handle",
          "type": "string"
        },
        "max_length": {
          "default": 256,
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "secret": {
          "const": false,
          "default": false,
          "title": "Secret",
          "type": "boolean"
        },
        "slot_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
          "title": "Slot Id",
          "type": "string"
        },
        "value_type": {
          "$ref": "#/$defs/ValueType",
          "default": "STRING"
        }
      },
      "required": [
        "slot_id",
        "logical_resource_handle"
      ],
      "title": "LogicalResourceSlot",
      "type": "object"
    },
    "MultipartBody": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "MULTIPART",
          "default": "MULTIPART",
          "title": "Kind",
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/MultipartPart"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        }
      },
      "required": [
        "parts"
      ],
      "title": "MultipartBody",
      "type": "object"
    },
    "MultipartPart": {
      "additionalProperties": false,
      "description": "Multipart 只允许 literal、Slot 或已登记 fixture/artifact 标识。",
      "properties": {
        "content_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$%&'*+.^_`|~-]*/[A-Za-z0-9][A-Za-z0-9!#$%&'*+.^_`|~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        },
        "filename": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filename"
        },
        "fixture_artifact_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Artifact Id"
        },
        "literal": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literal"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.~\\-]+$",
          "title": "Name",
          "type": "string"
        },
        "slot_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot Id"
        }
      },
      "required": [
        "name"
      ],
      "title": "MultipartPart",
      "type": "object"
    },
    "RecordedRequestTemplate": {
      "additionalProperties": false,
      "properties": {
        "json_body": {
          "additionalProperties": true,
          "title": "Json Body",
          "type": "object"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        }
      },
      "required": [
        "method",
        "relative_path"
      ],
      "title": "RecordedRequestTemplate",
      "type": "object"
    },
    "ResetEndpointStrategy": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "RESET_ENDPOINT",
          "default": "RESET_ENDPOINT",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "pattern": "^/[A-Za-z0-9_./{}~:@%+\\-]*$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "ResetEndpointStrategy",
      "type": "object"
    },
    "ResetNotRequiredStrategy": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "NOT_REQUIRED",
          "default": "NOT_REQUIRED",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "ResetNotRequiredStrategy",
      "type": "object"
    },
    "ResourceInjection": {
      "additionalProperties": false,
      "properties": {
        "consumer": {
          "$ref": "#/$defs/ResourceInjectionKind"
        },
        "location": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "template_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Template Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "consumer",
        "location",
        "template_fingerprint"
      ],
      "title": "ResourceInjection",
      "type": "object"
    },
    "ResourceInjectionKind": {
