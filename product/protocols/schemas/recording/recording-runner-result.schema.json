{
  "$defs": {
    "RecordingCleanupStatus": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "RecordingCleanupStatus",
      "type": "string"
    },
    "RecordingEvent": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "anyOf": [
            {
              "pattern": "^action_[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "body": {
          "anyOf": [
            {
              "maxLength": 262144,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "caused_by_action_id": {
          "anyOf": [
            {
              "pattern": "^action_[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caused By Action Id"
        },
        "element_locator": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Locator"
        },
        "field_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Name"
        },
        "frame_id": {
          "anyOf": [
            {
              "pattern": "^frame_[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Id"
        },
        "headers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecordingHeader"
          },
          "maxItems": 256,
          "title": "Headers",
          "type": "array"
        },
        "identity_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Identity Id",
          "type": "string"
        },
        "input_type": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Type"
        },
        "kind": {
          "$ref": "#/$defs/RecordingEventKind"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "method": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2,16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "occurred_at_us": {
          "minimum": 0,
          "title": "Occurred At Us",
          "type": "integer"
        },
        "page_id": {
          "anyOf": [
            {
              "pattern": "^page_[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Id"
        },
        "parent_page_id": {
          "anyOf": [
            {
              "pattern": "^page_[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Page Id"
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^(?:request|websocket)_[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "resource_type": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Type"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "status_code": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Code"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "sequence",
        "occurred_at_us",
        "kind",
        "identity_id"
      ],
      "title": "RecordingEvent",
      "type": "object"
    },
    "RecordingEventKind": {
      "enum": [
        "PAGE_OPENED",
        "PAGE_CLOSED",
        "FRAME_ATTACHED",
        "NAVIGATION",
        "REQUEST",
        "RESPONSE",
        "WEBSOCKET_OPENED",
        "WEBSOCKET_SENT",
        "WEBSOCKET_RECEIVED",
        "CONSOLE",
        "PAGE_ERROR",
        "SAFETY_BLOCKED",
        "UI_CLICK",
        "UI_INPUT_CHANGE",
        "UI_SUBMIT"
      ],
      "title": "RecordingEventKind",
      "type": "string"
    },
    "RecordingHeader": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,128}$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 8192,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "RecordingHeader",
      "type": "object"
    },
    "RecordingRunnerError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable"
      ],
      "title": "RecordingRunnerError",
      "type": "object"
    },
    "RecordingRunnerResultType": {
      "enum": [
        "CAPTURED",
        "FAILED",
        "CANCELLED",
        "SAFETY_STOPPED"
      ],
      "title": "RecordingRunnerResultType",
      "type": "string"
    },
    "RecordingState": {
      "enum": [
        "CREATED",
        "STARTING",
        "RECORDING",
        "CLEANING",
        "PROCESSING",
        "PENDING_REVIEW",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "SAFETY_STOPPED"
      ],
      "title": "RecordingState",
      "type": "string"
    },
    "RecordingStateEvent": {
      "additionalProperties": false,
      "properties": {
        "occurred_at_us": {
          "minimum": 0,
          "title": "Occurred At Us",
          "type": "integer"
        },
        "operator": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Operator",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/RecordingState"
        },
        "target": {
          "$ref": "#/$defs/RecordingState"
        }
      },
      "required": [
        "sequence",
        "source",
        "target",
        "operator",
        "occurred_at_us"
      ],
      "title": "RecordingStateEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cleanup_status": {
      "$ref": "#/$defs/RecordingCleanupStatus"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordingRunnerError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecordingEvent"
      },
      "maxItems": 10000,
      "title": "Events",
      "type": "array"
    },
    "finished_at_us": {
      "minimum": 0,
      "title": "Finished At Us",
      "type": "integer"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Reason Codes",
      "type": "array"
    },
    "recording_id": {
      "pattern": "^rec_[0-9a-f]{32}$",
      "title": "Recording Id",
      "type": "string"
    },
    "recording_state": {
      "$ref": "#/$defs/RecordingState"
    },
    "result_type": {
      "$ref": "#/$defs/RecordingRunnerResultType"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "state_events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecordingStateEvent"
      },
      "maxItems": 128,
      "title": "State Events",
      "type": "array"
    }
  },
  "required": [
    "recording_id",
    "project_id",
    "finished_at_us",
    "result_type",
    "recording_state",
    "cleanup_status"
  ],
  "title": "RecordingRunnerResult",
  "type": "object"
}
