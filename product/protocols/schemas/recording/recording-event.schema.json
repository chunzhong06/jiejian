{
  "$defs": {
    "RecordingEventKind": {
      "enum": [
        "PAGE_OPENED",
        "PAGE_CLOSED",
        "FRAME_ATTACHED",
        "NAVIGATION",
        "REQUEST",
        "RESPONSE",
        "WEBSOCKET_OPENED",
        "WEBSOCKET_SENT",
        "WEBSOCKET_RECEIVED",
        "CONSOLE",
        "PAGE_ERROR",
        "SAFETY_BLOCKED",
        "UI_CLICK",
        "UI_INPUT_CHANGE",
        "UI_SUBMIT"
      ],
      "title": "RecordingEventKind",
      "type": "string"
    },
    "RecordingHeader": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]{1,128}$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 8192,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "RecordingHeader",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2",
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "occurred_at_us": {
      "minimum": 0,
      "title": "Occurred At Us",
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/RecordingEventKind"
    },
    "identity_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Identity Id",
      "type": "string"
    },
    "page_id": {
      "anyOf": [
        {
          "pattern": "^page_[0-9]{6}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Id"
    },
    "frame_id": {
      "anyOf": [
        {
          "pattern": "^frame_[0-9]{6}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frame Id"
    },
    "request_id": {
      "anyOf": [
        {
          "pattern": "^(?:request|websocket)_[0-9]{6}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "action_id": {
      "anyOf": [
        {
          "pattern": "^action_[0-9]{6}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Id"
    },
    "caused_by_action_id": {
      "anyOf": [
        {
          "pattern": "^action_[0-9]{6}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caused By Action Id"
    },
    "parent_page_id": {
      "anyOf": [
        {
          "pattern": "^page_[0-9]{6}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Page Id"
    },
    "element_locator": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Element Locator"
    },
    "field_name": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Field Name"
    },
    "input_type": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Type"
    },
    "url": {
      "anyOf": [
        {
          "maxLength": 8192,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "method": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{2,16}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method"
    },
    "resource_type": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Type"
    },
    "status_code": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status Code"
    },
    "headers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecordingHeader"
      },
      "maxItems": 256,
      "title": "Headers",
      "type": "array"
    },
    "body": {
      "anyOf": [
        {
          "maxLength": 262144,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Body"
    },
    "message": {
      "anyOf": [
        {
          "maxLength": 8192,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "reason_code": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "sequence",
    "occurred_at_us",
    "kind",
    "identity_id"
  ],
  "title": "RecordingEvent",
  "type": "object"
}
