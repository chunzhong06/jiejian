{
  "$defs": {
    "RecordingAuthMethod": {
      "enum": [
        "COOKIE_SESSION",
        "BEARER"
      ],
      "title": "RecordingAuthMethod",
      "type": "string"
    },
    "RecordingBudget": {
      "additionalProperties": false,
      "properties": {
        "max_body_bytes": {
          "default": 65536,
          "maximum": 245760,
          "minimum": 256,
          "title": "Max Body Bytes",
          "type": "integer"
        },
        "max_contexts": {
          "default": 4,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Contexts",
          "type": "integer"
        },
        "max_duration_us": {
          "maximum": 3600000000,
          "minimum": 1,
          "title": "Max Duration Us",
          "type": "integer"
        },
        "max_events": {
          "default": 2000,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Events",
          "type": "integer"
        },
        "max_field_chars": {
          "default": 2048,
          "maximum": 8192,
          "minimum": 64,
          "title": "Max Field Chars",
          "type": "integer"
        },
        "max_pages": {
          "default": 8,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "max_total_payload_bytes": {
          "default": 2097152,
          "maximum": 3932160,
          "minimum": 1024,
          "title": "Max Total Payload Bytes",
          "type": "integer"
        }
      },
      "required": [
        "max_duration_us"
      ],
      "title": "RecordingBudget",
      "type": "object"
    },
    "RecordingCookieRef": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "maxLength": 253,
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "expires_at_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At Us"
        },
        "http_only": {
          "title": "Http Only",
          "type": "boolean"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "same_site": {
          "enum": [
            "STRICT",
            "LAX",
            "NONE"
          ],
          "title": "Same Site",
          "type": "string"
        },
        "secure": {
          "title": "Secure",
          "type": "boolean"
        },
        "value_ref": {
          "pattern": "^env:[A-Z][A-Z0-9_]{0,127}$",
          "title": "Value Ref",
          "type": "string"
        }
      },
      "required": [
        "name",
        "domain",
        "path",
        "secure",
        "http_only",
        "same_site",
        "value_ref"
      ],
      "title": "RecordingCookieRef",
      "type": "object"
    },
    "RecordingPurpose": {
      "enum": [
        "TARGET",
        "OBSERVATION",
        "RECOVERY"
      ],
      "title": "RecordingPurpose",
      "type": "string"
    },
    "RecordingSessionRef": {
      "additionalProperties": false,
      "properties": {
        "auth_method": {
          "$ref": "#/$defs/RecordingAuthMethod"
        },
        "bearer_ref": {
          "anyOf": [
            {
              "pattern": "^env:[A-Z][A-Z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bearer Ref"
        },
        "cookies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecordingCookieRef"
          },
          "maxItems": 32,
          "title": "Cookies",
          "type": "array"
        },
        "expires_at_us": {
          "minimum": 0,
          "title": "Expires At Us",
          "type": "integer"
        },
        "session_ref": {
          "pattern": "^session_[0-9a-f]{32}$",
          "title": "Session Ref",
          "type": "string"
        },
        "test_identity_id": {
          "pattern": "^tid_[0-9a-f]{32}$",
          "title": "Test Identity Id",
          "type": "string"
        }
      },
      "required": [
        "test_identity_id",
        "session_ref",
        "auth_method",
        "expires_at_us"
      ],
      "title": "RecordingSessionRef",
      "type": "object"
    },
    "WebTargetScope": {
      "additionalProperties": false,
      "description": "Web 目标的协议级授权范围。",
      "properties": {
        "allow_private_network": {
          "default": false,
          "title": "Allow Private Network",
          "type": "boolean"
        },
        "allowed_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "allowed_origins": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Origins",
          "type": "array"
        },
        "allowed_ports": {
          "items": {
            "type": "integer"
          },
          "title": "Allowed Ports",
          "type": "array"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "follow_redirects": {
          "const": false,
          "default": false,
          "title": "Follow Redirects",
          "type": "boolean"
        },
        "max_requests": {
          "default": 64,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_response_bytes": {
          "default": 262144,
          "maximum": 4194304,
          "minimum": 1,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "base_url",
        "allowed_origins",
        "allowed_hosts",
        "allowed_ports"
      ],
      "title": "WebTargetScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_revision": {
      "minimum": 1,
      "title": "Action Revision",
      "type": "integer"
    },
    "budget": {
      "$ref": "#/$defs/RecordingBudget"
    },
    "business_action_id": {
      "pattern": "^bac_[0-9a-f]{32}$",
      "title": "Business Action Id",
      "type": "string"
    },
    "created_at_us": {
      "minimum": 0,
      "title": "Created At Us",
      "type": "integer"
    },
    "effect_id": {
      "anyOf": [
        {
          "pattern": "^bef_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effect Id"
    },
    "headless": {
      "default": true,
      "title": "Headless",
      "type": "boolean"
    },
    "parent_recording_id": {
      "anyOf": [
        {
          "pattern": "^rec_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Recording Id"
    },
    "preparation_source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Preparation Source Fingerprint",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "purpose": {
      "$ref": "#/$defs/RecordingPurpose",
      "default": "TARGET"
    },
    "recording_id": {
      "pattern": "^rec_[0-9a-f]{32}$",
      "title": "Recording Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2",
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/RecordingSessionRef"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Sessions",
      "type": "array"
    },
    "target_scope": {
      "$ref": "#/$defs/WebTargetScope"
    },
    "test_identity_id": {
      "pattern": "^tid_[0-9a-f]{32}$",
      "title": "Test Identity Id",
      "type": "string"
    },
    "trace_enabled": {
      "const": false,
      "default": false,
      "title": "Trace Enabled",
      "type": "boolean"
    }
  },
  "required": [
    "recording_id",
    "project_id",
    "business_action_id",
    "action_revision",
    "test_identity_id",
    "preparation_source_fingerprint",
    "created_at_us",
    "target_scope",
    "sessions",
    "budget"
  ],
  "title": "RecordingRunnerRequest",
  "type": "object"
}
