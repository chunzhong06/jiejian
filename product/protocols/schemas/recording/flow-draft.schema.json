{
  "$defs": {
    "FlowDraftResourceCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^resource-[0-9a-f]{16}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "consumer": {
          "$ref": "#/$defs/ValueSlotConsumer"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "location": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "consumer",
        "location",
        "label"
      ],
      "title": "FlowDraftResourceCandidate",
      "type": "object"
    },
    "FlowDraftStep": {
      "additionalProperties": false,
      "properties": {
        "depends_on_step_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Depends On Step Ids",
          "type": "array"
        },
        "expected_statuses": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "maxItems": 32,
          "title": "Expected Statuses",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "json_body": {
          "additionalProperties": true,
          "title": "Json Body",
          "type": "object"
        },
        "method": {
          "anyOf": [
            {
              "enum": [
                "GET",
                "PATCH",
                "POST",
                "PUT",
                "DELETE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^request_[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "resource_candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FlowDraftResourceCandidate"
          },
          "maxItems": 128,
          "title": "Resource Candidates",
          "type": "array"
        },
        "sensitive_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Sensitive Fields",
          "type": "array"
        },
        "source_event_sequences": {
          "items": {
            "type": "integer"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Source Event Sequences",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "source_event_sequences"
      ],
      "title": "FlowDraftStep",
      "type": "object"
    },
    "FlowDraftVariable": {
      "additionalProperties": false,
      "properties": {
        "candidate_sources": {
          "items": {
            "$ref": "#/$defs/FlowDraftVariableSource"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Candidate Sources",
          "type": "array"
        },
        "confirmed_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/FlowDraftVariableSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "consumer_step_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Consumer Step Ids",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "placeholder": {
          "pattern": "^\\{[a-z][a-z0-9_-]{0,63}\\}$",
          "title": "Placeholder",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FlowDraftVariableStatus"
        }
      },
      "required": [
        "name",
        "placeholder",
        "status",
        "candidate_sources",
        "consumer_step_ids"
      ],
      "title": "FlowDraftVariable",
      "type": "object"
    },
    "FlowDraftVariableSource": {
      "additionalProperties": false,
      "properties": {
        "json_path": {
          "maxLength": 512,
          "pattern": "^\\$(?:\\.[A-Za-z_][A-Za-z0-9_-]*|\\[[0-9]+\\])*$|^\\$location(?:\\.[A-Za-z0-9_-]+)*$",
          "title": "Json Path",
          "type": "string"
        },
        "source_event_sequence": {
          "minimum": 1,
          "title": "Source Event Sequence",
          "type": "integer"
        },
        "source_step_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Source Step Id",
          "type": "string"
        }
      },
      "required": [
        "source_step_id",
        "source_event_sequence",
        "json_path"
      ],
      "title": "FlowDraftVariableSource",
      "type": "object"
    },
    "FlowDraftVariableStatus": {
      "enum": [
        "INFERRED",
        "UNCONFIRMED",
        "CONFIRMED"
      ],
      "title": "FlowDraftVariableStatus",
      "type": "string"
    },
    "ValueSlotConsumer": {
      "enum": [
        "PATH",
        "QUERY",
        "HEADER",
        "JSON_BODY",
        "FORM_FIELD",
        "MULTIPART_FIELD"
      ],
      "title": "ValueSlotConsumer",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_candidate_id": {
      "pattern": "^action_[0-9a-f]{32}$",
      "title": "Action Candidate Id",
      "type": "string"
    },
    "flow_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Flow Id",
      "type": "string"
    },
    "recommended_target_step_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommended Target Step Id"
    },
    "recording_id": {
      "pattern": "^rec_[0-9a-f]{32}$",
      "title": "Recording Id",
      "type": "string"
    },
    "resource_candidate_id": {
      "anyOf": [
        {
          "pattern": "^resource-[0-9a-f]{16}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Candidate Id"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/FlowDraftStep"
      },
      "maxItems": 2000,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "target_step_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Step Id"
    },
    "variables": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FlowDraftVariable"
      },
      "maxItems": 2000,
      "title": "Variables",
      "type": "array"
    }
  },
  "required": [
    "recording_id",
    "flow_id",
    "action_candidate_id",
    "revision",
    "steps"
  ],
  "title": "FlowDraft",
  "type": "object"
}
