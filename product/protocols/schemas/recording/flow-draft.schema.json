{
  "$defs": {
    "FlowDraftStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "identity_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Identity Id",
          "type": "string"
        },
        "alternate_identity_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alternate Identity Id"
        },
        "resource_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Id"
        },
        "alternate_resource_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alternate Resource Id"
        },
        "bindings_confirmed": {
          "default": false,
          "title": "Bindings Confirmed",
          "type": "boolean"
        },
        "method": {
          "anyOf": [
            {
              "enum": [
                "GET",
                "PATCH",
                "POST",
                "PUT",
                "DELETE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "json_body": {
          "additionalProperties": true,
          "title": "Json Body",
          "type": "object"
        },
        "expected_statuses": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "maxItems": 32,
          "title": "Expected Statuses",
          "type": "array"
        },
        "request_id": {
          "anyOf": [
            {
              "pattern": "^request_[0-9]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "action_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Action Ids",
          "type": "array"
        },
        "source_event_sequences": {
          "items": {
            "type": "integer"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Source Event Sequences",
          "type": "array"
        },
        "depends_on_step_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Depends On Step Ids",
          "type": "array"
        },
        "sensitive_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Sensitive Fields",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "identity_id",
        "source_event_sequences"
      ],
      "title": "FlowDraftStep",
      "type": "object"
    },
    "FlowDraftVariable": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "placeholder": {
          "pattern": "^\\{[a-z][a-z0-9_-]{0,63}\\}$",
          "title": "Placeholder",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FlowDraftVariableStatus"
        },
        "candidate_sources": {
          "items": {
            "$ref": "#/$defs/FlowDraftVariableSource"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Candidate Sources",
          "type": "array"
        },
        "confirmed_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/FlowDraftVariableSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "consumer_step_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Consumer Step Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "placeholder",
        "status",
        "candidate_sources",
        "consumer_step_ids"
      ],
      "title": "FlowDraftVariable",
      "type": "object"
    },
    "FlowDraftVariableSource": {
      "additionalProperties": false,
      "properties": {
        "source_step_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Source Step Id",
          "type": "string"
        },
        "source_event_sequence": {
          "minimum": 1,
          "title": "Source Event Sequence",
          "type": "integer"
        },
        "json_path": {
          "maxLength": 512,
          "pattern": "^\\$(?:\\.[A-Za-z_][A-Za-z0-9_-]*|\\[[0-9]+\\])*$|^\\$location(?:\\.[A-Za-z0-9_-]+)*$",
          "title": "Json Path",
          "type": "string"
        }
      },
      "required": [
        "source_step_id",
        "source_event_sequence",
        "json_path"
      ],
      "title": "FlowDraftVariableSource",
      "type": "object"
    },
    "FlowDraftVariableStatus": {
      "enum": [
        "INFERRED",
        "UNCONFIRMED",
        "CONFIRMED"
      ],
      "title": "FlowDraftVariableStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2",
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "recording_id": {
      "pattern": "^rec_[0-9a-f]{32}$",
      "title": "Recording Id",
      "type": "string"
    },
    "flow_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Flow Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/FlowDraftStep"
      },
      "maxItems": 2000,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "variables": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FlowDraftVariable"
      },
      "maxItems": 2000,
      "title": "Variables",
      "type": "array"
    },
    "owner_observer_path": {
      "default": "/owner/resources/{resource_id}",
      "title": "Owner Observer Path",
      "type": "string"
    },
    "reset_path": {
      "default": "/reset",
      "title": "Reset Path",
      "type": "string"
    }
  },
  "required": [
    "recording_id",
    "flow_id",
    "revision",
    "steps"
  ],
  "title": "FlowDraft",
  "type": "object"
}
