          "type": "string"
        },
        "operation": {
          "const": "CONFIRM_RESOURCE_SLOT",
          "title": "Operation",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "candidate_id"
      ],
      "title": "ConfirmFlowDraftResource",
      "type": "object"
    },
    "ConfirmFlowDraftTarget": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "CONFIRM_TARGET_STEP",
          "title": "Operation",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "step_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Step Id",
          "type": "string"
        }
