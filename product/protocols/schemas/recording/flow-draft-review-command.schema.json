      "CONFIRM_RESOURCE_SLOT": "#/$defs/ConfirmFlowDraftResource",
      "CONFIRM_TARGET_STEP": "#/$defs/ConfirmFlowDraftTarget",
      "CONFIRM_VARIABLE_CHOICE": "#/$defs/ConfirmFlowDraftVariableChoice"
