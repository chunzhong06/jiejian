{
  "$defs": {
    "EmptyBody": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "EMPTY",
          "default": "EMPTY",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "EmptyBody",
      "type": "object"
    },
    "FormUrlEncodedBody": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HttpParameter"
          },
          "maxItems": 128,
          "title": "Fields",
          "type": "array"
        },
        "kind": {
          "const": "FORM_URLENCODED",
          "default": "FORM_URLENCODED",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "FormUrlEncodedBody",
      "type": "object"
    },
    "HttpParameter": {
      "additionalProperties": false,
      "description": "受控 Query/Header/Form 字段；字段值只能是 literal 或已声明 Slot。",
      "properties": {
        "literal": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literal"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.~\\-]+$",
          "title": "Name",
          "type": "string"
        },
        "slot_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot Id"
        }
      },
      "required": [
        "name"
      ],
      "title": "HttpParameter",
      "type": "object"
    },
    "JsonBody": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "JSON",
          "default": "JSON",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "JsonBody",
      "type": "object"
    },
    "MultipartBody": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "MULTIPART",
          "default": "MULTIPART",
          "title": "Kind",
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/MultipartPart"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        }
      },
      "required": [
        "parts"
      ],
      "title": "MultipartBody",
      "type": "object"
    },
    "MultipartPart": {
      "additionalProperties": false,
      "description": "Multipart 只允许 literal、Slot 或已登记 fixture/artifact 标识。",
      "properties": {
        "content_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$%&'*+.^_`|~-]*/[A-Za-z0-9][A-Za-z0-9!#$%&'*+.^_`|~-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        },
        "filename": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]{1,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filename"
        },
        "fixture_artifact_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fixture Artifact Id"
        },
        "literal": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literal"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.~\\-]+$",
          "title": "Name",
          "type": "string"
        },
        "slot_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slot Id"
        }
      },
      "required": [
        "name"
      ],
      "title": "MultipartPart",
      "type": "object"
    },
    "ResponseExtractor": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z_:][A-Za-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribute"
        },
        "cookie_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cookie Name"
        },
        "extractor_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
          "title": "Extractor Id",
          "type": "string"
        },
        "header_name": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Name"
        },
        "json_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Path"
        },
        "kind": {
          "$ref": "#/$defs/ResponseExtractorKind"
        },
        "max_length": {
          "default": 256,
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        },
        "selector": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selector"
        }
      },
      "required": [
        "extractor_id",
        "kind"
      ],
      "title": "ResponseExtractor",
      "type": "object"
    },
    "ResponseExtractorKind": {
      "enum": [
        "JSON_PATH",
        "HEADER",
        "COOKIE",
        "LOCATION",
        "HTML_SELECTOR",
        "HTML_ATTRIBUTE"
      ],
      "title": "ResponseExtractorKind",
      "type": "string"
    },
    "ValueSlot": {
      "additionalProperties": false,
      "properties": {
        "consumer": {
          "$ref": "#/$defs/ValueSlotConsumer"
        },
        "consumer_step": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consumer Step"
        },
        "consumer_step_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consumer Step Id"
        },
        "literal": {
          "default": null,
          "title": "Literal"
        },
        "max_length": {
          "default": 256,
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Length",
          "type": "integer"
        },
        "producer_step": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Step"
        },
        "producer_step_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Step Id"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        },
        "secret_ref": {
          "anyOf": [
            {
              "pattern": "^env:[A-Z][A-Z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Secret Ref"
        },
        "slot_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$",
          "title": "Slot Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ValueSlotSource"
        },
        "source_path": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        },
        "value_type": {
          "$ref": "#/$defs/ValueType",
          "default": "STRING"
        }
      },
      "required": [
        "slot_id",
        "source",
        "consumer"
      ],
      "title": "ValueSlot",
      "type": "object"
    },
    "ValueSlotConsumer": {
      "enum": [
        "PATH",
        "QUERY",
        "HEADER",
        "JSON_BODY",
        "FORM_FIELD",
        "MULTIPART_FIELD"
      ],
      "title": "ValueSlotConsumer",
      "type": "string"
    },
    "ValueSlotSource": {
      "enum": [
        "CASE_SUBJECT_ID",
        "CASE_RESOURCE_ID",
        "FIXED_LITERAL",
        "SECRET_REF",
        "PRIOR_STEP_JSON_PATH",
        "PRIOR_STEP_HEADER",
        "PRIOR_STEP_COOKIE",
        "PRIOR_STEP_LOCATION"
      ],
      "title": "ValueSlotSource",
      "type": "string"
    },
    "ValueType": {
      "enum": [
        "STRING",
        "INTEGER",
        "BOOLEAN",
        "JSON"
      ],
      "title": "ValueType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "单请求受控模板；不接受 URL、脚本、任意文件或保留认证头。",
  "properties": {
    "body": {
      "discriminator": {
        "mapping": {
          "EMPTY": "#/$defs/EmptyBody",
          "FORM_URLENCODED": "#/$defs/FormUrlEncodedBody",
          "JSON": "#/$defs/JsonBody",
          "MULTIPART": "#/$defs/MultipartBody"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/EmptyBody"
        },
        {
          "$ref": "#/$defs/JsonBody"
        },
        {
          "$ref": "#/$defs/FormUrlEncodedBody"
        },
        {
          "$ref": "#/$defs/MultipartBody"
        }
      ],
      "title": "Body"
    },
    "headers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HttpParameter"
      },
      "maxItems": 128,
      "title": "Headers",
      "type": "array"
    },
    "input_slots": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ValueSlot"
      },
      "maxItems": 128,
      "title": "Input Slots",
      "type": "array"
    },
    "method": {
      "enum": [
        "GET",
        "PATCH",
        "POST",
        "PUT",
        "DELETE",
        "HEAD"
      ],
      "title": "Method",
      "type": "string"
    },
    "path": {
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "^/[A-Za-z0-9_./{}~:@%+\\-]*$",
      "title": "Path",
      "type": "string"
    },
    "query": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HttpParameter"
      },
      "maxItems": 128,
      "title": "Query",
      "type": "array"
    },
    "response_extractors": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResponseExtractor"
      },
      "maxItems": 128,
      "title": "Response Extractors",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "method",
    "path"
  ],
  "title": "HttpRequestTemplate",
  "type": "object"
}
