    "ObserverTarget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2",
          "default": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Target Id",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "ASYNC_TASK_STATUS": "#/$defs/AsyncTaskApiLocator",
              "AZURE_BLOB_OBJECT": "#/$defs/AzureBlobObjectLocator",
              "AZURE_QUEUE_PEEK": "#/$defs/AzureQueuePeekLocator",
              "OWNER_API": "#/$defs/OwnerApiLocator",
              "READ_ONLY_SQLITE": "#/$defs/SqliteQueryLocator",
              "STRUCTURED_AUDIT_LOG": "#/$defs/StructuredAuditLogLocator"
            },
            "propertyName": "locator_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/OwnerApiLocator"
            },
            {
              "$ref": "#/$defs/SqliteQueryLocator"
            },
            {
              "$ref": "#/$defs/StructuredAuditLogLocator"
            },
            {
              "$ref": "#/$defs/AsyncTaskApiLocator"
            },
            {
              "$ref": "#/$defs/AzureQueuePeekLocator"
            },
            {
              "$ref": "#/$defs/AzureBlobObjectLocator"
            }
          ],
          "title": "Locator"
        },
        "normalization_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Normalization Id",
          "type": "string"
        },
        "normalization_version": {
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$",
          "title": "Normalization Version",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "locator",
        "normalization_id",
        "normalization_version"
      ],
      "title": "ObserverTarget",
      "type": "object"
    },
    "ObserverType": {
      "enum": [
        "OWNER_API",
        "READ_ONLY_SQLITE",
        "STRUCTURED_AUDIT_LOG",
        "ASYNC_TASK_STATUS",
        "AZURE_QUEUE_PEEK",
        "AZURE_BLOB_OBJECT"
      ],
      "title": "ObserverType",
      "type": "string"
    },
