    "case_budget": {
      "maximum": 8192,
      "minimum": 1,
      "title": "Case Budget",
      "type": "integer"
    },
    "max_relation_depth": {
      "maximum": 64,
      "minimum": 1,
      "title": "Max Relation Depth",
      "type": "integer"
    },
    "max_duration_us": {
