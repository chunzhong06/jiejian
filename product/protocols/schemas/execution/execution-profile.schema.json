          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Observer Id",
          "type": "string"
        },
        "observer_type": {
          "$ref": "#/$defs/ObserverType"
        },
        "protocol_version": {
          "const": "2",
          "default": "2",
          "title": "Protocol Version",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ObserverTarget"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/ObservationPhase"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Phases",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "budget": {
          "$ref": "#/$defs/ObserverBudget"
        }
