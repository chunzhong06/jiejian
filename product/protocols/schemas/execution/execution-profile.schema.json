{
  "$defs": {
    "ActionExecutionBinding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2",
          "default": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "action_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Action Id",
          "type": "string"
        },
        "target_type": {
          "$ref": "#/$defs/TargetType",
          "default": "WEB"
        },
        "method": {
          "enum": [
            "GET",
            "PATCH",
            "POST",
            "PUT",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "relative_path_template": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Relative Path Template",
          "type": "string"
        },
        "json_body": {
          "additionalProperties": true,
          "title": "Json Body",
          "type": "object"
        },
        "accepted_statuses": {
          "items": {
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Accepted Statuses",
          "type": "array"
        },
        "denied_statuses": {
          "default": [
            401,
            403,
            404
          ],
          "items": {
            "type": "integer"
          },
          "maxItems": 32,
          "title": "Denied Statuses",
          "type": "array"
        },
        "resource_injection": {
          "$ref": "#/$defs/ResourceInjection"
        }
      },
      "required": [
        "action_id",
        "method",
        "relative_path_template",
        "accepted_statuses",
        "resource_injection"
      ],
      "title": "ActionExecutionBinding",
      "type": "object"
    },
    "AsyncTaskApiLocator": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2",
          "default": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "locator_type": {
          "const": "ASYNC_TASK_STATUS",
          "default": "ASYNC_TASK_STATUS",
          "title": "Locator Type",
          "type": "string"
        },
        "base_url": {
          "maxLength": 256,
          "minLength": 12,
          "title": "Base Url",
          "type": "string"
        },
        "relative_path_template": {
          "maxLength": 512,
          "minLength": 18,
          "title": "Relative Path Template",
          "type": "string"
        },
        "read_only_credential_ref": {
          "pattern": "^env:[A-Z_][A-Z0-9_]{0,63}$",
          "title": "Read Only Credential Ref",
          "type": "string"
        },
        "allow_private_network": {
          "title": "Allow Private Network",
          "type": "boolean"
        },
        "allow_loopback_http": {
          "title": "Allow Loopback Http",
          "type": "boolean"
        },
        "poll_budget": {
          "$ref": "#/$defs/AsyncTaskPollBudget"
        }
      },
      "required": [
        "base_url",
        "relative_path_template",
        "read_only_credential_ref",
        "allow_private_network",
        "allow_loopback_http",
        "poll_budget"
      ],
      "title": "AsyncTaskApiLocator",
      "type": "object"
    },
    "AsyncTaskPollBudget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2",
          "default": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "max_polls": {
          "maximum": 256,
          "minimum": 1,
          "title": "Max Polls",
          "type": "integer"
        },
        "poll_interval_us": {
          "maximum": 120000000,
          "minimum": 0,
          "title": "Poll Interval Us",
          "type": "integer"
        },
        "per_request_timeout_us": {
          "maximum": 120000000,
          "minimum": 1,
          "title": "Per Request Timeout Us",
          "type": "integer"
        },
        "max_response_bytes": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Max Response Bytes",
          "type": "integer"
        }
      },
      "required": [
        "max_polls",
        "poll_interval_us",
        "per_request_timeout_us",
        "max_response_bytes"
      ],
      "title": "AsyncTaskPollBudget",
      "type": "object"
    },
    "AuditLogScanBudget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2",
          "default": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "max_files": {
          "maximum": 64,
          "minimum": 1,
          "title": "Max Files",
          "type": "integer"
        },
        "max_lines": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Lines",
          "type": "integer"
        },
        "max_line_bytes": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Max Line Bytes",
          "type": "integer"
        }
      },
      "required": [
        "max_files",
        "max_lines",
        "max_line_bytes"
      ],
      "title": "AuditLogScanBudget",
      "type": "object"
    },
    "AzureBlobObjectLocator": {
