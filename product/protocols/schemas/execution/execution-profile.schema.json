  "required": [
    "profile_id",
    "project_id",
    "project_name",
    "target",
    "identities",
    "contract_id",
    "contract_version",
    "subject_bindings",
    "action_bindings",
    "observer_bindings",
    "seed",
    "case_budget",
    "max_relation_depth",
    "max_duration_us"
