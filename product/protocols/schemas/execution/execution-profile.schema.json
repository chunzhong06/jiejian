      "type": "object"
    },
    "TargetType": {
      "enum": [
        "WEB",
        "CLI_APPLICATION",
        "MCP_AGENT"
      ],
      "title": "TargetType",
      "type": "string"
    },
    "WebTargetDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2",
          "default": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/WebTargetScope"
        },
        "reset_path": {
          "pattern": "^/[A-Za-z0-9_./{}-]{1,255}$",
          "title": "Reset Path",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "reset_path"
      ],
      "title": "WebTargetDefinition",
      "type": "object"
    },
    "WebTargetScope": {
      "additionalProperties": false,
      "description": "Web 目标的协议级授权范围；不依赖 Core 的历史 TargetScope。",
      "properties": {
        "schema_version": {
          "const": "2",
          "default": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "allowed_origins": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Origins",
          "type": "array"
        },
        "allowed_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "allowed_ports": {
          "items": {
            "type": "integer"
          },
          "title": "Allowed Ports",
          "type": "array"
        },
        "allow_private_network": {
          "default": false,
          "title": "Allow Private Network",
          "type": "boolean"
        },
        "follow_redirects": {
          "const": false,
          "default": false,
          "title": "Follow Redirects",
          "type": "boolean"
        },
        "timeout_seconds": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_requests": {
          "default": 64,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_response_bytes": {
          "default": 262144,
          "maximum": 4194304,
          "minimum": 1,
          "title": "Max Response Bytes",
          "type": "integer"
        }
      },
      "required": [
        "base_url",
        "allowed_origins",
        "allowed_hosts",
        "allowed_ports"
      ],
      "title": "WebTargetScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "完整、无秘密的  权限执行配置；不含运行时 Job 或结果字段。",
  "properties": {
