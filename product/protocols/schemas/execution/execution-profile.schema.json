    "ObserverRequirementBinding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2",
          "default": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ObserverRequirementKind"
        },
        "observer_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observer Id"
        },
        "observer_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObserverType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "credential_ref": {
          "anyOf": [
            {
              "pattern": "^env:[A-Z][A-Z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Ref"
        },
        "phases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservationPhase"
          },
          "maxItems": 5,
          "title": "Phases",
          "type": "array"
        }
      },
      "required": [
        "requirement_id",
        "kind"
      ],
      "title": "ObserverRequirementBinding",
      "type": "object"
    },
    "ObserverRequirementKind": {
      "enum": [
        "OBSERVER_SPEC"
      ],
      "title": "ObserverRequirementKind",
      "type": "string"
