{
  "additionalProperties": false,
  "properties": {
    "control_session_id": {
      "pattern": "^rcs_[0-9a-f]{32}$",
      "title": "Control Session Id",
      "type": "string"
    },
    "created_at_us": {
      "minimum": 0,
      "title": "Created At Us",
      "type": "integer"
    },
    "instance_id": {
      "pattern": "^rti_[0-9a-f]{32}$",
      "title": "Instance Id",
      "type": "string"
    },
    "load_id": {
      "pattern": "^rld_[0-9a-f]{32}$",
      "title": "Load Id",
      "type": "string"
    },
    "manifest_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Fingerprint",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Operation Id",
      "type": "string"
    },
    "preview_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Preview Fingerprint",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    }
