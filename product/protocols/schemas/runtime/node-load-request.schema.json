  "required": [
    "load_id",
    "project_id",
    "operation_id",
    "control_session_id",
    "preview_fingerprint",
    "instance_id",
    "manifest_fingerprint",
    "source_fingerprint",
    "created_at_us"
  ],
  "title": "NodeRuntimeLoadRequest",
  "type": "object"
}
