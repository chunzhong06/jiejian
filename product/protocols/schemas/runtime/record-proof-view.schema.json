{
  "$defs": {
    "ActivityEvent": {
      "additionalProperties": false,
      "description": "宿主观察到的技术调用；不携带业务值、授权决定或提交成功的断言。",
      "properties": {
        "duration_us": {
          "minimum": 0,
          "title": "Duration Us",
          "type": "integer"
        },
        "event_id": {
          "pattern": "^call_[0-9a-f]{32}$",
          "title": "Event Id",
          "type": "string"
        },
        "http_method": {
          "anyOf": [
            {
              "enum": [
                "GET",
                "HEAD",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "OPTIONS",
                "CONNECT",
                "TRACE",
                "OTHER"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Method"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Status"
        },
        "kind": {
          "enum": [
            "HTTP_SERVER",
            "HTTP_CLIENT",
            "SQLITE",
            "FILESYSTEM"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operation": {
          "enum": [
            "REQUEST",
            "EXEC",
            "PREPARE",
            "RUN",
            "GET",
            "ALL",
            "ITERATE",
            "READ",
            "WRITE",
            "APPEND"
          ],
          "title": "Operation",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "OK",
            "ERROR",
            "INCOMPLETE"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "parent_event_id": {
          "anyOf": [
            {
              "pattern": "^call_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Event Id"
        },
        "source_location": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Location"
        },
        "started_at_us": {
          "minimum": 0,
          "title": "Started At Us",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "parent_event_id",
        "kind",
        "operation",
        "started_at_us",
        "duration_us",
        "outcome"
      ],
      "title": "ActivityEvent",
      "type": "object"
    },
    "RecordOperation": {
      "additionalProperties": false,
      "properties": {
        "after_version": {
          "minimum": 1,
          "title": "After Version",
          "type": "integer"
        },
        "before_version": {
          "minimum": 0,
          "title": "Before Version",
          "type": "integer"
        },
        "collection": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Collection",
          "type": "string"
        },
        "commit_semantics": {
          "const": "ATOMIC_COMMIT",
          "default": "ATOMIC_COMMIT",
          "title": "Commit Semantics",
          "type": "string"
        },
        "generation": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Generation",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Operation Id",
          "type": "string"
        },
        "owner_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Owner Id",
          "type": "string"
        },
        "request_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Request Key",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Resource Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2",
          "default": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Id"
        },
        "scope_ordinal": {
          "anyOf": [
            {
              "maximum": 31,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Ordinal"
        },
        "state": {
          "const": "COMMITTED",
          "default": "COMMITTED",
          "title": "State",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Subject Id",
          "type": "string"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/RecordTransition"
          },
          "maxItems": 8,
          "title": "Transitions",
          "type": "array"
        }
      },
      "required": [
        "operation_id",
        "generation",
        "collection",
        "resource_id",
        "owner_id",
        "subject_id",
        "request_key",
        "before_version",
        "after_version",
        "transitions"
      ],
      "title": "RecordOperation",
      "type": "object"
    },
    "RecordRequestScope": {
      "additionalProperties": false,
      "description": "宿主独立记录的请求完成边界；应用不能通过业务事务声明完成。",
      "properties": {
        "activity": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestActivity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "generation": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Generation",
          "type": "string"
        },
        "request_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "request_nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Nonce",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Scope Id",
          "type": "string"
        },
        "state": {
          "default": "OPEN",
          "enum": [
            "OPEN",
            "COMPLETE",
            "INCOMPLETE"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "scope_id",
        "generation",
        "request_nonce",
        "request_digest"
      ],
      "title": "RecordRequestScope",
      "type": "object"
    },
    "RecordSnapshot": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Collection",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "generation": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Generation",
          "type": "string"
        },
        "last_operation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Operation Id"
        },
        "owner_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Owner Id",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Resource Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "generation",
        "collection",
        "resource_id",
        "owner_id",
        "version",
        "data"
      ],
      "title": "RecordSnapshot",
      "type": "object"
    },
    "RecordTransition": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "additionalProperties": true,
          "title": "After",
          "type": "object"
        },
        "before": {
          "additionalProperties": true,
          "title": "Before",
          "type": "object"
        },
        "ordinal": {
          "maximum": 7,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        }
      },
      "required": [
        "ordinal",
        "before",
        "after"
      ],
      "title": "RecordTransition",
      "type": "object"
    },
    "RequestActivity": {
      "additionalProperties": false,
      "description": "一次真实请求内的有界诊断记录；complete 仅表示已启用探针的收集闭合。",
      "properties": {
        "adapters": {
          "items": {
            "enum": [
              "node:http",
              "node:https",
              "node:sqlite",
              "node:fs",
              "node:fs/promises",
              "better-sqlite3"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "title": "Adapters",
          "type": "array"
        },
        "collector": {
          "const": "CONTROLLED_NODE",
          "default": "CONTROLLED_NODE",
          "title": "Collector",
          "type": "string"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "dropped_count": {
          "default": 0,
          "minimum": 0,
          "title": "Dropped Count",
          "type": "integer"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/ActivityEvent"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "request_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "request_nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Nonce",
          "type": "string"
        }
      },
      "required": [
        "request_nonce",
        "request_digest",
        "adapters",
        "complete",
        "events"
      ],
      "title": "RequestActivity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "operation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordOperation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operation_projection": {
      "default": "REQUEST",
      "enum": [
        "REQUEST",
        "RESOURCE"
      ],
      "title": "Operation Projection",
      "type": "string"
    },
    "operations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RecordOperation"
      },
      "maxItems": 32,
      "title": "Operations",
      "type": "array"
    },
    "schema_version": {
      "default": "2",
      "enum": [
        "2",
        "3"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordRequestScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "snapshot": {
      "$ref": "#/$defs/RecordSnapshot"
    }
  },
  "required": [
    "snapshot"
  ],
  "title": "RecordProofView",
  "type": "object"
}
