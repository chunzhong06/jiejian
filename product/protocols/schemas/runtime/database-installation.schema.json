{
  "$defs": {
    "DatabaseCapture": {
      "additionalProperties": false,
      "properties": {
        "connection_id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Connection Id",
          "type": "string"
        },
        "database": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Database",
          "type": "string"
        },
        "engine": {
          "enum": [
            "POSTGRESQL",
            "MYSQL"
          ],
          "title": "Engine",
          "type": "string"
        },
        "fields": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "host": {
          "const": "127.0.0.1",
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "namespace": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Namespace",
          "type": "string"
        },
        "owner_column": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Owner Column",
          "type": "string"
        },
        "password_env": {
          "pattern": "^JIEJIAN_DB_[A-Z0-9_]{1,64}$",
          "title": "Password Env",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1024,
          "title": "Port",
          "type": "integer"
        },
        "resource_column": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Resource Column",
          "type": "string"
        },
        "table": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Table",
          "type": "string"
        },
        "username": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "connection_id",
        "engine",
        "port",
        "database",
        "namespace",
        "username",
        "password_env",
        "table",
        "resource_column",
        "owner_column",
        "fields"
      ],
      "title": "DatabaseCapture",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capture": {
      "$ref": "#/$defs/DatabaseCapture"
    },
    "completed_at_us": {
      "minimum": 0,
      "title": "Completed At Us",
      "type": "integer"
    },
    "definitions": {
      "maxProperties": 8,
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]{0,62}$": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "title": "Definitions",
      "type": "object"
    },
    "document_type": {
      "const": "jiejian.database-installation",
      "default": "jiejian.database-installation",
      "title": "Document Type",
      "type": "string"
    },
    "generation": {
      "pattern": "^sql_[0-9a-f]{32}$",
      "title": "Generation",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^ppf_[0-9a-f]{32}$",
      "title": "Operation Id",
      "type": "string"
    },
    "plan_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Fingerprint",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "INCOMPLETE",
        "INSTALLED",
        "REMOVING",
        "REMOVED"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "operation_id",
    "plan_fingerprint",
    "capture",
    "generation",
    "definitions",
    "state",
    "completed_at_us"
  ],
  "title": "DatabaseInstallation",
  "type": "object"
}
