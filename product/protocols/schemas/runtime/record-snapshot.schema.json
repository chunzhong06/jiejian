        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Operation Id"
    },
    "owner_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Owner Id",
