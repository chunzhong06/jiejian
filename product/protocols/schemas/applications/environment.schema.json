{
  "$defs": {
    "FrozenEnvironment": {
      "additionalProperties": false,
      "properties": {
        "deployment_label": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deployment Label"
        },
        "deployment_verification": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Deployment Verification",
          "type": "string"
        },
        "environment_id": {
          "pattern": "^env_[0-9a-f]{32}$",
          "title": "Environment Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/WebTargetScope"
        }
      },
      "required": [
        "environment_id",
        "revision",
        "name",
        "target"
      ],
      "title": "FrozenEnvironment",
      "type": "object"
    },
    "WebTargetScope": {
      "additionalProperties": false,
      "description": "Web 目标的协议级授权范围。",
      "properties": {
        "allow_private_network": {
          "default": false,
          "title": "Allow Private Network",
          "type": "boolean"
        },
        "allowed_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "allowed_origins": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Origins",
          "type": "array"
        },
        "allowed_ports": {
          "items": {
            "type": "integer"
          },
          "title": "Allowed Ports",
          "type": "array"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "follow_redirects": {
          "const": false,
          "default": false,
          "title": "Follow Redirects",
          "type": "boolean"
        },
        "max_requests": {
          "default": 64,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_response_bytes": {
          "default": 262144,
          "maximum": 4194304,
          "minimum": 1,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "base_url",
        "allowed_origins",
        "allowed_hosts",
        "allowed_ports"
      ],
      "title": "WebTargetScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "configuration": {
      "$ref": "#/$defs/FrozenEnvironment"
    },
    "created_at_us": {
      "minimum": 0,
      "title": "Created At Us",
      "type": "integer"
    },
    "document_type": {
      "const": "jiejian.application-environment",
      "default": "jiejian.application-environment",
      "title": "Document Type",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "configuration",
    "created_at_us"
  ],
  "title": "EnvironmentDocument",
  "type": "object"
}
