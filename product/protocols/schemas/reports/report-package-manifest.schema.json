{
  "$defs": {
    "ReportPackageFile": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Byte Count",
          "type": "integer"
        },
        "path": {
          "enum": [
            "report.json",
            "report.html",
            "report.sarif.json",
            "report.junit.xml"
          ],
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "byte_count",
        "sha256"
      ],
      "title": "ReportPackageFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_report_id": {
      "pattern": "^report_[0-9a-f]{32}$",
      "title": "Base Report Id",
      "type": "string"
    },
    "canonical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Sha256",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ReportPackageFile"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Files",
      "type": "array"
    },
    "gate_result_id": {
      "anyOf": [
        {
          "pattern": "^gate_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gate Result Id"
    },
    "report_id": {
      "pattern": "^report_[0-9a-f]{32}$",
      "title": "Report Id",
      "type": "string"
    },
    "report_type": {
      "enum": [
        "BASE",
        "GATE"
      ],
      "title": "Report Type",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "run_id",
    "report_type",
    "base_report_id",
    "canonical_sha256",
    "files"
  ],
  "title": "ReportPackageManifest",
  "type": "object"
}
