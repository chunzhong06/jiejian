{
  "$defs": {
    "ArtifactSummary": {
      "additionalProperties": false,
      "properties": {
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Reason Codes",
          "type": "array"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/ReportArtifact"
          },
          "maxItems": 256,
          "title": "Results",
          "type": "array"
        },
        "snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ArtifactSummaryStatus"
        }
      },
      "required": [
        "status",
        "results",
        "snapshot_sha256"
      ],
      "title": "ArtifactSummary",
      "type": "object"
    },
    "ArtifactSummaryStatus": {
      "enum": [
        "NOT_REQUESTED",
        "COMPLETE",
        "INCONCLUSIVE"
      ],
      "title": "ArtifactSummaryStatus",
      "type": "string"
    },
    "BaseRunReport": {
      "additionalProperties": false,
      "properties": {
        "artifact_summary": {
          "$ref": "#/$defs/ArtifactSummary"
        },
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Limitations",
          "type": "array"
        },
        "presentation": {
          "$ref": "#/$defs/ReportPresentation"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "report_id": {
          "pattern": "^report_[0-9a-f]{32}$",
          "title": "Report Id",
          "type": "string"
        },
        "report_type": {
          "const": "BASE",
          "title": "Report Type",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/ReportRun"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/ReportRuntime"
        },
        "schema_version": {
          "const": "2",
          "default": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Semantic Input Sha256",
          "type": "string"
        },
        "versions": {
          "$ref": "#/$defs/ReportVersions"
        }
      },
      "required": [
        "report_type",
        "report_id",
        "run_id",
        "project_id",
        "semantic_input_sha256",
        "canonical_sha256",
        "run",
        "runtime",
        "presentation",
        "artifact_summary",
        "versions"
      ],
      "title": "BaseRunReport",
      "type": "object"
    },
    "GateRunReport": {
      "additionalProperties": false,
      "properties": {
        "artifact_summary": {
          "$ref": "#/$defs/ArtifactSummary"
        },
        "base_report_id": {
          "pattern": "^report_[0-9a-f]{32}$",
          "title": "Base Report Id",
          "type": "string"
        },
        "base_report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Base Report Sha256",
          "type": "string"
        },
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/ReportGate"
        },
        "gate_result_id": {
          "pattern": "^gate_[0-9a-f]{32}$",
          "title": "Gate Result Id",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Limitations",
          "type": "array"
        },
        "presentation": {
          "$ref": "#/$defs/ReportPresentation"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "report_id": {
          "pattern": "^report_[0-9a-f]{32}$",
          "title": "Report Id",
          "type": "string"
        },
        "report_type": {
          "const": "GATE",
          "title": "Report Type",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/ReportRun"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/ReportRuntime"
        },
        "schema_version": {
          "const": "2",
          "default": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Semantic Input Sha256",
          "type": "string"
        },
        "versions": {
          "$ref": "#/$defs/ReportVersions"
        }
      },
      "required": [
        "report_type",
        "report_id",
        "run_id",
        "project_id",
        "base_report_id",
        "base_report_sha256",
        "gate_result_id",
        "semantic_input_sha256",
        "canonical_sha256",
        "run",
        "runtime",
        "presentation",
        "artifact_summary",
        "versions",
        "gate"
      ],
      "title": "GateRunReport",
      "type": "object"
    },
    "ReportArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ReportEvidenceRef"
          },
          "maxItems": 4096,
          "title": "Evidence Refs",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ReportFinding"
          },
          "maxItems": 4096,
          "title": "Findings",
          "type": "array"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "ruleset_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Ruleset Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "INCONCLUSIVE"
          ],
          "title": "Status",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "SAFE",
            "VULNERABLE",
            "INCONCLUSIVE"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "status",
        "verdict",
        "manifest_sha256",
        "ruleset_version",
        "evidence_refs",
        "findings"
      ],
      "title": "ReportArtifact",
      "type": "object"
    },
    "ReportConfirmedImpact": {
      "additionalProperties": false,
      "properties": {
        "effect_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Id"
        },
        "event_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}$",
          "title": "Event Id",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "enum": [
            "ENTRY",
            "IDENTITY",
            "AUTHORIZATION",
            "PERSISTENT_EFFECT",
            "MESSAGE",
            "DELEGATION",
            "FINAL_EFFECT",
            "RECOVERY"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent_event_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Parent Event Ids",
          "type": "array"
        },
        "semantic_key": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Semantic Key",
          "type": "string"
        },
        "summary": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "kind",
        "semantic_key",
        "summary"
      ],
      "title": "ReportConfirmedImpact",
      "type": "object"
    },
    "ReportDiagnosis": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}$",
          "title": "Action Id",
          "type": "string"
        },
        "breakpoint_type": {
          "enum": [
            "AUTHORIZATION_MISSING",
            "AUTHORIZATION_LATE",
            "AUTHORIZATION_BYPASS",
            "IDENTITY_SUBSTITUTION",
            "AUTHORITY_EXPANSION",
            "COMPENSATION_MASKING"
          ],
          "title": "Breakpoint Type",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,159}$",
          "title": "Case Id",
          "type": "string"
        },
        "confirmed_impacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReportConfirmedImpact"
          },
          "maxItems": 512,
          "title": "Confirmed Impacts",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "minimal_witness": {
          "items": {
            "$ref": "#/$defs/ReportWitnessItem"
          },
          "maxItems": 5,
          "minItems": 5,
          "title": "Minimal Witness",
          "type": "array"
        },
        "precision": {
          "enum": [
            "EXACT",
            "RANGE",
            "VIOLATION_ONLY"
          ],
          "title": "Precision",
          "type": "string"
        },
        "summary": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "action_id",
        "breakpoint_type",
        "precision",
        "summary",
        "minimal_witness",
        "evidence_refs"
      ],
      "title": "ReportDiagnosis",
      "type": "object"
    },
    "ReportEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^(?:ev_[0-9a-f]{20}|aev_[0-9a-f]{20})$",
          "title": "Evidence Id",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "RUNTIME",
            "ARTIFACT"
          ],
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_type"
      ],
      "title": "ReportEvidenceRef",
      "type": "object"
    },
    "ReportFinding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ReportEvidenceRef"
          },
          "maxItems": 64,
          "title": "Evidence Refs",
          "type": "array"
        },
        "finding_id": {
          "pattern": "^(?:finding_[0-9a-f]{32}|af_[0-9a-f]{32})$",
          "title": "Finding Id",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "occurrence_id": {
          "anyOf": [
            {
              "pattern": "^occ_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence Id"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "rule_id": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "RUNTIME",
            "ARTIFACT"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "SAFE",
            "VULNERABLE",
            "INCONCLUSIVE",
            "SKIPPED",
            "ERROR"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "source_type",
        "verdict",
        "severity",
        "evidence_refs"
      ],
      "title": "ReportFinding",
      "type": "object"
    },
    "ReportGate": {
      "additionalProperties": false,
      "properties": {
        "baseline_id": {
          "pattern": "^baseline_[0-9a-f]{32}$",
          "title": "Baseline Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "PASS",
            "BLOCK",
            "ERROR"
          ],
          "title": "Decision",
          "type": "string"
        },
        "evaluated_at_us": {
          "minimum": 0,
          "title": "Evaluated At Us",
          "type": "integer"
        },
        "gate_result_id": {
          "pattern": "^gate_[0-9a-f]{32}$",
          "title": "Gate Result Id",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "policy_version": {
          "const": "gate-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "reasons": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "maxItems": 8192,
          "title": "Reasons",
          "type": "array"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "gate_result_id",
        "baseline_id",
        "run_id",
        "policy_version",
        "input_hash",
        "decision",
        "reasons",
        "evaluated_at_us"
      ],
      "title": "ReportGate",
      "type": "object"
    },
    "ReportObserverStatus": {
      "additionalProperties": false,
      "properties": {
        "observer_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Observer Id",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reason Codes",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "observer_id",
        "required",
        "status"
      ],
      "title": "ReportObserverStatus",
      "type": "object"
    },
    "ReportPresentation": {
      "additionalProperties": false,
      "description": "冻结确定性结果投影，供所有人类报告格式复用。",
      "properties": {
        "checked_count": {
          "minimum": 0,
          "title": "Checked Count",
          "type": "integer"
        },
        "execution_problem": {
          "anyOf": [
            {
              "maxLength": 320,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Problem"
        },
        "headline": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "inconclusive_count": {
          "minimum": 0,
          "title": "Inconclusive Count",
          "type": "integer"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReportPresentationIssue"
          },
          "maxItems": 8192,
          "title": "Issues",
          "type": "array"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Limitations",
          "type": "array"
        },
        "problem_count": {
          "minimum": 0,
          "title": "Problem Count",
          "type": "integer"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "project_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Project Name",
          "type": "string"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "run_lifecycle": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "CANCELLED",
            "SAFETY_STOPPED"
          ],
          "title": "Run Lifecycle",
          "type": "string"
        },
        "safe_count": {
          "minimum": 0,
          "title": "Safe Count",
          "type": "integer"
        },
        "scope_statement": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Scope Statement",
          "type": "string"
        },
        "uncovered_count": {
          "minimum": 0,
          "title": "Uncovered Count",
          "type": "integer"
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "PASS",
                "BLOCK",
                "INCONCLUSIVE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verdict"
        }
      },
      "required": [
        "run_id",
        "project_id",
        "project_name",
        "run_lifecycle",
        "verdict",
        "headline",
        "scope_statement",
        "checked_count",
        "safe_count",
        "problem_count",
        "inconclusive_count",
        "uncovered_count"
      ],
      "title": "ReportPresentation",
      "type": "object"
    },
    "ReportPresentationIssue": {
      "additionalProperties": false,
      "description": "冻结单个权限问题的人类可读表达，不承载新的安全判断。",
      "properties": {
        "action": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "actual_result": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Actual Result",
          "type": "string"
        },
        "conclusion": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "diagnosis": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportDiagnosis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 8192,
          "title": "Evidence Refs",
          "type": "array"
        },
        "expectation": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Expectation",
          "type": "string"
        },
        "explanation": {
          "maxLength": 480,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "finding_id": {
          "pattern": "^(?:finding_[0-9a-f]{32}|af_[0-9a-f]{32})$",
          "title": "Finding Id",
          "type": "string"
        },
        "occurrence_status": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence Status"
        },
        "relation": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Relation",
          "type": "string"
        },
        "resource": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        },
        "severity": {
          "enum": [
            "unknown",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "subject_group": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Subject Group",
          "type": "string"
        },
        "surface_result": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Surface Result",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "SAFE",
            "VULNERABLE",
            "INCONCLUSIVE"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "title",
        "subject_group",
        "action",
        "resource",
        "relation",
        "expectation",
        "surface_result",
        "actual_result",
        "conclusion",
        "explanation",
        "severity",
