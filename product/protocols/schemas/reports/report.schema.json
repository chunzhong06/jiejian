{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jiejian/reports/report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "run_id", "project_id", "gate_result_id", "semantic_input_sha256", "canonical_sha256", "run", "runtime", "artifacts", "gate", "versions", "limitations"],
  "properties": {
    "schema_version": {"const": "2"},
    "report_id": {"type": "string", "pattern": "^report_[0-9a-f]{32}$"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "gate_result_id": {"type": "string", "pattern": "^gate_[0-9a-f]{32}$"},
    "semantic_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run": {"$ref": "#/$defs/run"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "artifacts": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/artifact"}},
    "gate": {"$ref": "#/$defs/gate"},
    "versions": {"$ref": "#/$defs/versions"},
    "limitations": {"type": "array", "maxItems": 256, "items": {"type": "string"}}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "evidence_id", "source_type"],
      "properties": {
        "schema_version": {"const": "2"},
        "evidence_id": {"type": "string", "pattern": "^(?:ev_[0-9a-f]{20}|aev_[0-9a-f]{20})$"},
        "source_type": {"enum": ["RUNTIME", "ARTIFACT"]}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "finding_id", "source_type", "occurrence_id", "verdict", "severity", "evidence_refs", "rule_id", "category", "path", "message"],
      "properties": {
        "schema_version": {"const": "2"},
        "finding_id": {"type": "string", "pattern": "^(?:finding_[0-9a-f]{32}|af_[0-9a-f]{32})$"},
        "source_type": {"enum": ["RUNTIME", "ARTIFACT"]},
        "occurrence_id": {"type": ["string", "null"]},
        "verdict": {"enum": ["SAFE", "VULNERABLE", "INCONCLUSIVE", "SKIPPED", "ERROR"]},
        "severity": {"enum": ["low", "medium", "high", "critical", "unknown"]},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "rule_id": {"type": ["string", "null"]},
        "category": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "message": {"type": ["string", "null"]}
      }
    },
    "observer": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "observer_id", "required", "status", "reason_codes"],
      "properties": {
        "schema_version": {"const": "2"}, "observer_id": {"type": "string"}, "required": {"type": "boolean"},
        "status": {"type": "string"}, "reason_codes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "lifecycle", "verdict", "evidence_refs", "findings", "observer_statuses", "execution_errors"],
      "properties": {
        "schema_version": {"const": "2"}, "lifecycle": {"type": "string"}, "verdict": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "observer_statuses": {"type": "array", "items": {"$ref": "#/$defs/observer"}},
        "execution_errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_id", "status", "verdict", "error_code", "manifest_sha256", "ruleset_version", "evidence_refs", "findings"],
      "properties": {
        "schema_version": {"const": "2"}, "artifact_id": {"type": "string"},
        "status": {"enum": ["COMPLETE", "INCONCLUSIVE"]}, "verdict": {"enum": ["SAFE", "VULNERABLE", "INCONCLUSIVE"]},
        "error_code": {"type": ["string", "null"]}, "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ruleset_version": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "gate_result_id", "baseline_id", "run_id", "policy_version", "input_hash", "decision", "reasons", "evaluated_at_us"],
      "properties": {
        "schema_version": {"const": "2"}, "gate_result_id": {"type": "string"}, "baseline_id": {"type": "string"}, "run_id": {"type": "string"},
        "policy_version": {"const": "gate-v1"}, "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decision": {"enum": ["PASS", "BLOCK", "ERROR"]}, "reasons": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "subject"], "properties": {"code": {"type": "string"}, "subject": {"type": "string"}}}},
        "evaluated_at_us": {"type": "integer", "minimum": 0}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "project_id", "lifecycle", "verdict", "created_at_us", "finished_at_us"],
      "properties": {
        "schema_version": {"const": "2"}, "run_id": {"type": "string"}, "project_id": {"type": "string"}, "lifecycle": {"type": "string"},
        "verdict": {"type": ["string", "null"]}, "created_at_us": {"type": "integer", "minimum": 0}, "finished_at_us": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "versions": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "contract_id", "contract_version", "engine_version", "runner_schema_version", "observer_schema_version", "report_schema_version", "ruleset_versions"],
      "properties": {
        "schema_version": {"const": "2"}, "contract_id": {"type": "string"}, "contract_version": {"type": "integer", "minimum": 1},
        "engine_version": {"type": "string"}, "runner_schema_version": {"enum": ["1", "2"]}, "observer_schema_version": {"enum": ["1", "2"]},
        "report_schema_version": {"const": "2"}, "ruleset_versions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
