{
  "$defs": {
    "ArtifactSummary": {
      "additionalProperties": false,
      "properties": {
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Reason Codes",
          "type": "array"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/ReportArtifact"
          },
          "maxItems": 256,
          "title": "Results",
          "type": "array"
        },
        "schema_version": {
          "const": "3",
          "default": "3",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ArtifactSummaryStatus"
        }
      },
      "required": [
        "status",
        "results",
        "snapshot_sha256"
      ],
      "title": "ArtifactSummary",
      "type": "object"
    },
    "ArtifactSummaryStatus": {
      "enum": [
        "NOT_REQUESTED",
        "COMPLETE",
        "INCONCLUSIVE"
      ],
      "title": "ArtifactSummaryStatus",
      "type": "string"
    },
    "BaseRunReport": {
      "additionalProperties": false,
      "properties": {
        "artifact_summary": {
          "$ref": "#/$defs/ArtifactSummary"
        },
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Limitations",
          "type": "array"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "report_id": {
          "pattern": "^report_[0-9a-f]{32}$",
          "title": "Report Id",
          "type": "string"
        },
        "report_type": {
          "const": "BASE",
          "title": "Report Type",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/ReportRun"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/ReportRuntime"
        },
        "schema_version": {
          "const": "3",
          "default": "3",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Semantic Input Sha256",
          "type": "string"
        },
        "versions": {
          "$ref": "#/$defs/ReportVersions"
        }
      },
      "required": [
        "report_type",
        "report_id",
        "run_id",
        "project_id",
        "semantic_input_sha256",
        "canonical_sha256",
        "run",
        "runtime",
        "artifact_summary",
        "versions"
      ],
      "title": "BaseRunReport",
      "type": "object"
    },
    "GateRunReport": {
      "additionalProperties": false,
      "properties": {
        "artifact_summary": {
          "$ref": "#/$defs/ArtifactSummary"
        },
        "base_report_id": {
          "pattern": "^report_[0-9a-f]{32}$",
          "title": "Base Report Id",
          "type": "string"
        },
        "base_report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Base Report Sha256",
          "type": "string"
        },
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/ReportGate"
        },
        "gate_result_id": {
          "pattern": "^gate_[0-9a-f]{32}$",
          "title": "Gate Result Id",
          "type": "string"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Limitations",
          "type": "array"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "report_id": {
          "pattern": "^report_[0-9a-f]{32}$",
          "title": "Report Id",
          "type": "string"
        },
        "report_type": {
          "const": "GATE",
          "title": "Report Type",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/ReportRun"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/ReportRuntime"
        },
        "schema_version": {
          "const": "3",
          "default": "3",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Semantic Input Sha256",
          "type": "string"
        },
        "versions": {
          "$ref": "#/$defs/ReportVersions"
        }
      },
      "required": [
        "report_type",
        "report_id",
        "run_id",
        "project_id",
        "base_report_id",
        "base_report_sha256",
        "gate_result_id",
        "semantic_input_sha256",
        "canonical_sha256",
        "run",
        "runtime",
        "artifact_summary",
        "versions",
        "gate"
      ],
      "title": "GateRunReport",
      "type": "object"
    },
    "ReportArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ReportEvidenceRef"
          },
          "maxItems": 4096,
          "title": "Evidence Refs",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ReportFinding"
          },
          "maxItems": 4096,
          "title": "Findings",
          "type": "array"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "ruleset_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Ruleset Version",
          "type": "string"
        },
        "schema_version": {
          "const": "3",
          "default": "3",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "INCONCLUSIVE"
          ],
          "title": "Status",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "SAFE",
            "VULNERABLE",
            "INCONCLUSIVE"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "status",
        "verdict",
        "manifest_sha256",
        "ruleset_version",
        "evidence_refs",
        "findings"
      ],
      "title": "ReportArtifact",
      "type": "object"
    },
    "ReportEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^(?:ev_[0-9a-f]{20}|aev_[0-9a-f]{20})$",
          "title": "Evidence Id",
          "type": "string"
        },
        "schema_version": {
          "const": "3",
          "default": "3",
          "title": "Schema Version",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "RUNTIME",
            "ARTIFACT"
          ],
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_type"
      ],
      "title": "ReportEvidenceRef",
      "type": "object"
    },
    "ReportFinding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ReportEvidenceRef"
          },
          "maxItems": 64,
          "title": "Evidence Refs",
          "type": "array"
        },
        "finding_id": {
          "pattern": "^(?:finding_[0-9a-f]{32}|af_[0-9a-f]{32})$",
          "title": "Finding Id",
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "occurrence_id": {
          "anyOf": [
            {
              "pattern": "^occ_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence Id"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "rule_id": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "schema_version": {
          "const": "3",
          "default": "3",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "RUNTIME",
            "ARTIFACT"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "SAFE",
            "VULNERABLE",
            "INCONCLUSIVE",
            "SKIPPED",
            "ERROR"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "source_type",
        "verdict",
        "severity",
        "evidence_refs"
      ],
      "title": "ReportFinding",
      "type": "object"
    },
    "ReportGate": {
      "additionalProperties": false,
      "properties": {
        "baseline_id": {
          "pattern": "^baseline_[0-9a-f]{32}$",
          "title": "Baseline Id",
          "type": "string"
        },
        "decision": {
          "enum": [
            "PASS",
            "BLOCK",
            "ERROR"
          ],
          "title": "Decision",
          "type": "string"
        },
        "evaluated_at_us": {
          "minimum": 0,
          "title": "Evaluated At Us",
          "type": "integer"
        },
        "gate_result_id": {
          "pattern": "^gate_[0-9a-f]{32}$",
          "title": "Gate Result Id",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "policy_version": {
          "const": "gate-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "reasons": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "maxItems": 8192,
          "title": "Reasons",
          "type": "array"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "3",
          "default": "3",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "gate_result_id",
        "baseline_id",
        "run_id",
        "policy_version",
        "input_hash",
        "decision",
        "reasons",
        "evaluated_at_us"
      ],
      "title": "ReportGate",
      "type": "object"
    },
    "ReportObserverStatus": {
      "additionalProperties": false,
      "properties": {
        "observer_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Observer Id",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reason Codes",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "schema_version": {
          "const": "3",
          "default": "3",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "observer_id",
        "required",
        "status"
      ],
      "title": "ReportObserverStatus",
      "type": "object"
    },
    "ReportRun": {
      "additionalProperties": false,
      "properties": {
        "created_at_us": {
          "minimum": 0,
          "title": "Created At Us",
          "type": "integer"
        },
        "finished_at_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At Us"
        },
        "lifecycle": {
          "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
          "title": "Lifecycle",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "3",
          "default": "3",
          "title": "Schema Version",
          "type": "string"
        },
        "verdict": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        }
      },
      "required": [
        "run_id",
        "project_id",
        "lifecycle",
        "created_at_us"
      ],
      "title": "ReportRun",
      "type": "object"
    },
    "ReportRuntime": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ReportEvidenceRef"
          },
          "maxItems": 8192,
          "title": "Evidence Refs",
          "type": "array"
        },
        "execution_errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Execution Errors",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/ReportFinding"
          },
          "maxItems": 8192,
          "title": "Findings",
          "type": "array"
        },
        "lifecycle": {
          "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
          "title": "Lifecycle",
          "type": "string"
        },
        "observer_statuses": {
          "items": {
            "$ref": "#/$defs/ReportObserverStatus"
          },
          "maxItems": 8192,
          "title": "Observer Statuses",
          "type": "array"
        },
        "schema_version": {
          "const": "3",
          "default": "3",
          "title": "Schema Version",
          "type": "string"
        },
        "verdict": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        }
      },
      "required": [
        "lifecycle",
        "evidence_refs",
        "findings",
        "observer_statuses"
      ],
      "title": "ReportRuntime",
      "type": "object"
    },
    "ReportVersions": {
      "additionalProperties": false,
      "properties": {
        "artifact_schema_version": {
          "const": "1",
          "title": "Artifact Schema Version",
          "type": "string"
        },
        "contract_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "contract_version": {
          "minimum": 1,
          "title": "Contract Version",
          "type": "integer"
        },
        "engine_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Engine Version",
          "type": "string"
        },
        "evidence_schema_version": {
          "const": "3",
          "title": "Evidence Schema Version",
          "type": "string"
        },
        "observer_schema_version": {
          "const": "2",
          "title": "Observer Schema Version",
          "type": "string"
        },
        "report_schema_version": {
          "const": "3",
          "default": "3",
          "title": "Report Schema Version",
          "type": "string"
        },
        "ruleset_versions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Ruleset Versions",
          "type": "array"
        },
        "runner_schema_version": {
          "const": "3",
          "title": "Runner Schema Version",
          "type": "string"
        },
        "schema_version": {
          "const": "3",
          "default": "3",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "contract_version",
        "engine_version",
        "runner_schema_version",
        "evidence_schema_version",
        "observer_schema_version",
        "artifact_schema_version"
      ],
      "title": "ReportVersions",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "BASE": "#/$defs/BaseRunReport",
      "GATE": "#/$defs/GateRunReport"
    },
    "propertyName": "report_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/BaseRunReport"
    },
    {
      "$ref": "#/$defs/GateRunReport"
    }
  ]
}
