{
  "$defs": {
    "ArtifactEvidence": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^aev_[0-9a-f]{20}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "maximum": 10000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Reason Code",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Rule Id",
          "type": "string"
        },
        "source_type": {
          "const": "ARTIFACT",
          "default": "ARTIFACT",
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "artifact_id",
        "manifest_sha256",
        "rule_id",
        "path",
        "fingerprint",
        "reason_code"
      ],
      "title": "ArtifactEvidence",
      "type": "object"
    },
    "ArtifactFinding": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "SECRET_CANDIDATE",
            "FORBIDDEN_FILE",
            "SOURCE_MAP",
            "FRONTEND_SERVER_SECRET",
            "DEPENDENCY_VERSION"
          ],
          "title": "Category",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^aev_[0-9a-f]{20}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "finding_id": {
          "pattern": "^af_[0-9a-f]{32}$",
          "title": "Finding Id",
          "type": "string"
        },
        "message": {
          "enum": [
            "检测到秘密候选",
            "检测到禁止发布文件",
            "检测到 Source Map",
            "前端产物包含明显服务端秘密",
            "依赖版本低于固定本地规则集要求"
          ],
          "title": "Message",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_type": {
          "const": "ARTIFACT",
          "default": "ARTIFACT",
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "artifact_id",
        "rule_id",
        "category",
        "severity",
        "path",
        "evidence_id",
        "message"
      ],
      "title": "ArtifactFinding",
      "type": "object"
    },
    "ArtifactScanStatus": {
      "enum": [
        "COMPLETE",
        "INCONCLUSIVE"
      ],
      "title": "ArtifactScanStatus",
      "type": "string"
    },
    "ArtifactVerdict": {
      "enum": [
        "SAFE",
        "VULNERABLE",
        "INCONCLUSIVE"
      ],
      "title": "ArtifactVerdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactEvidence"
      },
      "maxItems": 4096,
      "title": "Evidence",
      "type": "array"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactFinding"
      },
      "maxItems": 4096,
      "title": "Findings",
      "type": "array"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "ruleset_version": {
      "const": "artifact-local-2026.08.18",
      "default": "artifact-local-2026.08.18",
      "title": "Ruleset Version",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "pattern": "^run_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "scanned_byte_count": {
      "maximum": 1073741824,
      "minimum": 0,
      "title": "Scanned Byte Count",
      "type": "integer"
    },
    "scanned_file_count": {
      "maximum": 4096,
      "minimum": 0,
      "title": "Scanned File Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_type": {
      "const": "ARTIFACT",
      "default": "ARTIFACT",
      "title": "Source Type",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ArtifactScanStatus"
    },
    "verdict": {
      "$ref": "#/$defs/ArtifactVerdict"
    }
  },
  "required": [
    "project_id",
    "artifact_id",
    "status",
    "verdict",
    "manifest_sha256",
    "scanned_file_count",
    "scanned_byte_count"
  ],
  "title": "ArtifactScanResult",
  "type": "object"
}
