{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jiejian/artifacts/artifact-result-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "project_id", "result_sha256", "input_manifest_sha256", "files"],
  "properties": {
    "schema_version": {"const": "1"},
    "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {"type": "array", "minItems": 1, "maxItems": 1}
  }
}
