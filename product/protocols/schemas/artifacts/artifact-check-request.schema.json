{
  "$defs": {
    "ScanBudget": {
      "additionalProperties": false,
      "properties": {
        "max_compressed_layers": {
          "default": 0,
          "maximum": 0,
          "minimum": 0,
          "title": "Max Compressed Layers",
          "type": "integer"
        },
        "max_duration_us": {
          "default": 30000000,
          "maximum": 300000000,
          "minimum": 1000,
          "title": "Max Duration Us",
          "type": "integer"
        },
        "max_file_bytes": {
          "default": 16777216,
          "maximum": 67108864,
          "minimum": 1,
          "title": "Max File Bytes",
          "type": "integer"
        },
        "max_files": {
          "default": 4096,
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Files",
          "type": "integer"
        },
        "max_parallel_files": {
          "const": 1,
          "default": 1,
          "title": "Max Parallel Files",
          "type": "integer"
        },
        "max_results": {
          "default": 4096,
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Results",
          "type": "integer"
        },
        "max_total_bytes": {
          "default": 536870912,
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Max Total Bytes",
          "type": "integer"
        }
      },
      "title": "ScanBudget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_root": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Artifact Root",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/ScanBudget"
    },
    "manifest_path": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Manifest Path",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "ruleset_version": {
      "const": "artifact-local-2026.08.18",
      "default": "artifact-local-2026.08.18",
      "title": "Ruleset Version",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "pattern": "^run_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "artifact_id",
    "artifact_root",
    "manifest_path"
  ],
  "title": "ArtifactCheckRequest",
  "type": "object"
}
