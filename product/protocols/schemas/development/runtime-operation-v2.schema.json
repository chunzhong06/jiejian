{
  "$defs": {
    "NodeRuntimeReference": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "pattern": "^rti_[0-9a-f]{32}$",
          "title": "Instance Id",
          "type": "string"
        },
        "manifest_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Fingerprint",
          "type": "string"
        },
        "mode": {
          "const": "CONTROLLED_NODE_ESM",
          "default": "CONTROLLED_NODE_ESM",
          "title": "Mode",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1024,
          "title": "Port",
          "type": "integer"
        },
        "process_created_at": {
          "exclusiveMinimum": 0,
          "title": "Process Created At",
          "type": "integer"
        },
        "process_id": {
          "exclusiveMinimum": 0,
          "title": "Process Id",
          "type": "integer"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "source_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "instance_id",
        "manifest_fingerprint",
        "source_fingerprint",
        "process_id",
        "process_created_at",
        "port"
      ],
      "title": "NodeRuntimeReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at_us": {
      "minimum": 0,
      "title": "Created At Us",
      "type": "integer"
    },
    "delivery_id": {
      "pattern": "^dly_[0-9a-f]{32}$",
      "title": "Delivery Id",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "kind": {
      "const": "LOAD_RUNTIME",
      "default": "LOAD_RUNTIME",
      "title": "Kind",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Operation Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "request_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "runtime_load_id": {
      "pattern": "^rld_[0-9a-f]{32}$",
      "title": "Runtime Load Id",
      "type": "string"
    },
    "runtime_reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/NodeRuntimeReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "2",
      "default": "2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Fingerprint",
      "type": "string"
    },
    "status": {
      "enum": [
        "PENDING",
        "SUCCEEDED",
        "FAILED",
        "UNKNOWN"
      ],
      "title": "Status",
      "type": "string"
    },
    "task_id": {
      "pattern": "^dvt_[0-9a-f]{32}$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "operation_id",
    "request_fingerprint",
    "task_id",
    "delivery_id",
    "source_fingerprint",
    "status",
    "created_at_us",
    "runtime_load_id"
  ],
  "title": "NodeRuntimeActivationReceipt",
  "type": "object"
}
