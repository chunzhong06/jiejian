{
  "$defs": {
    "CausalityStatus": {
      "enum": [
        "CORRELATED",
        "UNVERIFIED"
      ],
      "title": "CausalityStatus",
      "type": "string"
    },
    "Correlation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "request_marker": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Request Marker",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "resource_id",
        "request_marker"
      ],
      "title": "Correlation",
      "type": "object"
    },
    "NormalizedState": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "maximum": 262144,
          "minimum": 2,
          "title": "Byte Count",
          "type": "integer"
        },
        "canonical_data": {
          "additionalProperties": true,
          "title": "Canonical Data",
          "type": "object"
        },
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        }
      },
      "required": [
        "canonical_data",
        "canonical_sha256",
        "byte_count"
      ],
      "title": "NormalizedState",
      "type": "object"
    },
    "ObservationCompleteness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "MISSING",
        "TIMED_OUT",
        "UNSUPPORTED",
        "ERROR"
      ],
      "title": "ObservationCompleteness",
      "type": "string"
    },
    "ObservationPhase": {
      "enum": [
        "INITIAL",
        "BASELINE",
        "BEFORE",
        "AFTER",
        "EVENTUAL"
      ],
      "title": "ObservationPhase",
      "type": "string"
    },
    "ObservationProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Adapter Version",
          "type": "string"
        },
        "provenance_type": {
          "$ref": "#/$defs/ProvenanceType"
        },
        "query_template_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Template Id"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "provenance_type",
        "adapter_version",
        "target_id",
        "source_sha256"
      ],
      "title": "ObservationProvenance",
      "type": "object"
    },
    "ObservationWindow": {
      "additionalProperties": false,
      "properties": {
        "finished_at_us": {
          "minimum": 0,
          "title": "Finished At Us",
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/ObservationPhase"
        },
        "started_at_us": {
          "minimum": 0,
          "title": "Started At Us",
          "type": "integer"
        },
        "timeout_us": {
          "maximum": 120000000,
          "minimum": 1,
          "title": "Timeout Us",
          "type": "integer"
        }
      },
      "required": [
        "phase",
        "started_at_us",
        "finished_at_us",
        "timeout_us"
      ],
      "title": "ObservationWindow",
      "type": "object"
    },
    "ObserverType": {
      "enum": [
        "OWNER_API",
        "READ_ONLY_SQLITE",
        "STRUCTURED_AUDIT_LOG",
        "ASYNC_TASK_STATUS",
        "AZURE_QUEUE_PEEK",
        "AZURE_BLOB_OBJECT"
      ],
      "title": "ObserverType",
      "type": "string"
    },
    "ProvenanceType": {
      "enum": [
        "OWNER_API",
        "SQLITE_QUERY",
        "AUDIT_LOG_WINDOW",
        "ASYNC_TASK_API",
        "AZURE_QUEUE_PEEK",
        "AZURE_BLOB_OBJECT"
      ],
      "title": "ProvenanceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "causality": {
      "$ref": "#/$defs/CausalityStatus"
    },
    "completeness": {
      "$ref": "#/$defs/ObservationCompleteness"
    },
    "correlation": {
      "$ref": "#/$defs/Correlation"
    },
    "observer_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Observer Id",
      "type": "string"
    },
    "observer_type": {
      "$ref": "#/$defs/ObserverType"
    },
    "phase": {
      "$ref": "#/$defs/ObservationPhase"
    },
    "protocol_version": {
      "const": "3",
      "default": "3",
      "title": "Protocol Version",
      "type": "string"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObservationProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason_codes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Reason Codes",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/NormalizedState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "target_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Target Id",
      "type": "string"
    },
    "window": {
      "$ref": "#/$defs/ObservationWindow"
    }
  },
  "required": [
    "observer_id",
    "observer_type",
    "phase",
    "target_id",
    "window",
    "correlation",
    "causality",
    "completeness"
  ],
  "title": "ObservationEnvelope",
  "type": "object"
}
