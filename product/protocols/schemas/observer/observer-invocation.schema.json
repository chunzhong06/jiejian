{
  "$defs": {
    "AsyncTaskApiLocator": {
      "additionalProperties": false,
      "properties": {
        "allow_loopback_http": {
          "title": "Allow Loopback Http",
          "type": "boolean"
        },
        "allow_private_network": {
          "title": "Allow Private Network",
          "type": "boolean"
        },
        "base_url": {
          "maxLength": 256,
          "minLength": 12,
          "title": "Base Url",
          "type": "string"
        },
        "locator_type": {
          "const": "ASYNC_TASK_STATUS",
          "default": "ASYNC_TASK_STATUS",
          "title": "Locator Type",
          "type": "string"
        },
        "poll_budget": {
          "$ref": "#/$defs/AsyncTaskPollBudget"
        },
        "read_only_credential_ref": {
          "pattern": "^env:[A-Z_][A-Z0-9_]{0,63}$",
          "title": "Read Only Credential Ref",
          "type": "string"
        },
        "relative_path_template": {
          "maxLength": 512,
          "minLength": 18,
          "title": "Relative Path Template",
          "type": "string"
        }
      },
      "required": [
        "base_url",
        "relative_path_template",
        "read_only_credential_ref",
        "allow_private_network",
        "allow_loopback_http",
        "poll_budget"
      ],
      "title": "AsyncTaskApiLocator",
      "type": "object"
    },
    "AsyncTaskPollBudget": {
      "additionalProperties": false,
      "properties": {
        "max_polls": {
          "maximum": 256,
          "minimum": 1,
          "title": "Max Polls",
          "type": "integer"
        },
        "max_response_bytes": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "per_request_timeout_us": {
          "maximum": 120000000,
          "minimum": 1,
          "title": "Per Request Timeout Us",
          "type": "integer"
        },
        "poll_interval_us": {
          "maximum": 120000000,
          "minimum": 0,
          "title": "Poll Interval Us",
          "type": "integer"
        }
      },
      "required": [
        "max_polls",
        "poll_interval_us",
        "per_request_timeout_us",
        "max_response_bytes"
      ],
      "title": "AsyncTaskPollBudget",
      "type": "object"
    },
    "AuditLogScanBudget": {
      "additionalProperties": false,
      "properties": {
        "max_files": {
          "maximum": 64,
          "minimum": 1,
          "title": "Max Files",
          "type": "integer"
        },
        "max_line_bytes": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Max Line Bytes",
          "type": "integer"
        },
        "max_lines": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Lines",
          "type": "integer"
        }
      },
      "required": [
        "max_files",
        "max_lines",
        "max_line_bytes"
      ],
      "title": "AuditLogScanBudget",
      "type": "object"
    },
    "AzureBlobObjectLocator": {
      "additionalProperties": false,
      "properties": {
        "allow_loopback_http": {
          "title": "Allow Loopback Http",
          "type": "boolean"
        },
        "allowed_metadata_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Allowed Metadata Fields",
          "type": "array"
        },
        "container_name": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])$",
          "title": "Container Name",
          "type": "string"
        },
        "exclusive_test_container": {
          "const": true,
          "title": "Exclusive Test Container",
          "type": "boolean"
        },
        "locator_type": {
          "const": "AZURE_BLOB_OBJECT",
          "default": "AZURE_BLOB_OBJECT",
          "title": "Locator Type",
          "type": "string"
        },
        "prefix_template": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Prefix Template",
          "type": "string"
        },
        "read_only_sas_ref": {
          "pattern": "^env:[A-Z_][A-Z0-9_]{0,63}$",
          "title": "Read Only Sas Ref",
          "type": "string"
        },
        "scan_budget": {
          "$ref": "#/$defs/BlobObjectScanBudget"
        },
        "service_url": {
          "maxLength": 256,
          "minLength": 24,
          "title": "Service Url",
          "type": "string"
        }
      },
      "required": [
        "allow_loopback_http",
        "service_url",
        "container_name",
        "prefix_template",
        "read_only_sas_ref",
        "exclusive_test_container",
        "allowed_metadata_fields",
        "scan_budget"
      ],
      "title": "AzureBlobObjectLocator",
      "type": "object"
    },
    "AzureQueuePeekLocator": {
      "additionalProperties": false,
      "properties": {
        "allow_loopback_http": {
          "title": "Allow Loopback Http",
          "type": "boolean"
        },
        "allowed_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 4,
          "title": "Allowed Fields",
          "type": "array"
        },
        "exclusive_test_queue": {
          "const": true,
          "title": "Exclusive Test Queue",
          "type": "boolean"
        },
        "locator_type": {
          "const": "AZURE_QUEUE_PEEK",
          "default": "AZURE_QUEUE_PEEK",
          "title": "Locator Type",
          "type": "string"
        },
        "peek_budget": {
          "$ref": "#/$defs/QueuePeekBudget"
        },
        "queue_name": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])$",
          "title": "Queue Name",
          "type": "string"
        },
        "read_only_sas_ref": {
          "pattern": "^env:[A-Z_][A-Z0-9_]{0,63}$",
          "title": "Read Only Sas Ref",
          "type": "string"
        },
        "service_url": {
          "maxLength": 256,
          "minLength": 24,
          "title": "Service Url",
          "type": "string"
        }
      },
      "required": [
        "allow_loopback_http",
        "service_url",
        "queue_name",
        "read_only_sas_ref",
        "exclusive_test_queue",
        "allowed_fields",
        "peek_budget"
      ],
      "title": "AzureQueuePeekLocator",
      "type": "object"
    },
    "BlobObjectScanBudget": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_object_bytes": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Max Object Bytes",
          "type": "integer"
        },
        "max_objects": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Objects",
          "type": "integer"
        },
        "max_pages": {
          "maximum": 256,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "max_total_bytes": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Max Total Bytes",
          "type": "integer"
        },
        "page_size": {
          "maximum": 5000,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "per_request_timeout_us": {
          "maximum": 120000000,
          "minimum": 1,
          "title": "Per Request Timeout Us",
          "type": "integer"
        },
        "retry_interval_us": {
          "maximum": 120000000,
          "minimum": 0,
          "title": "Retry Interval Us",
          "type": "integer"
        }
      },
      "required": [
        "page_size",
        "max_pages",
        "max_objects",
        "max_object_bytes",
        "max_total_bytes",
        "max_attempts",
        "per_request_timeout_us",
        "retry_interval_us"
      ],
      "title": "BlobObjectScanBudget",
      "type": "object"
    },
    "Correlation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "request_marker": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Request Marker",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "resource_id",
        "request_marker"
      ],
      "title": "Correlation",
      "type": "object"
    },
    "ObservationPhase": {
      "enum": [
        "INITIAL",
        "BASELINE",
        "BEFORE",
        "AFTER",
        "EVENTUAL"
      ],
      "title": "ObservationPhase",
      "type": "string"
    },
    "ObserverBudget": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "max_rows": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Rows",
          "type": "integer"
        },
        "timeout_us": {
          "maximum": 120000000,
          "minimum": 1,
          "title": "Timeout Us",
          "type": "integer"
        }
      },
      "required": [
        "timeout_us",
        "max_rows",
        "max_bytes"
      ],
      "title": "ObserverBudget",
      "type": "object"
    },
    "ObserverSpec": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/ObserverBudget"
        },
        "observer_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Observer Id",
          "type": "string"
        },
        "observer_type": {
          "$ref": "#/$defs/ObserverType"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/ObservationPhase"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Phases",
          "type": "array"
        },
        "protocol_version": {
          "const": "2",
          "default": "2",
          "title": "Protocol Version",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "target": {
          "$ref": "#/$defs/ObserverTarget"
        }
      },
      "required": [
        "observer_id",
        "observer_type",
        "target",
        "phases",
        "required",
        "budget"
      ],
      "title": "ObserverSpec",
      "type": "object"
    },
    "ObserverTarget": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "discriminator": {
            "mapping": {
              "ASYNC_TASK_STATUS": "#/$defs/AsyncTaskApiLocator",
              "AZURE_BLOB_OBJECT": "#/$defs/AzureBlobObjectLocator",
              "AZURE_QUEUE_PEEK": "#/$defs/AzureQueuePeekLocator",
              "OWNER_API": "#/$defs/OwnerApiLocator",
              "READ_ONLY_SQLITE": "#/$defs/SqliteQueryLocator",
              "STRUCTURED_AUDIT_LOG": "#/$defs/StructuredAuditLogLocator"
            },
            "propertyName": "locator_type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/OwnerApiLocator"
            },
            {
              "$ref": "#/$defs/SqliteQueryLocator"
            },
            {
              "$ref": "#/$defs/StructuredAuditLogLocator"
            },
            {
              "$ref": "#/$defs/AsyncTaskApiLocator"
            },
            {
              "$ref": "#/$defs/AzureQueuePeekLocator"
            },
            {
              "$ref": "#/$defs/AzureBlobObjectLocator"
            }
          ],
          "title": "Locator"
        },
        "normalization_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Normalization Id",
          "type": "string"
        },
        "normalization_version": {
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$",
          "title": "Normalization Version",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "locator",
        "normalization_id",
        "normalization_version"
      ],
      "title": "ObserverTarget",
      "type": "object"
    },
    "ObserverType": {
      "enum": [
        "OWNER_API",
        "READ_ONLY_SQLITE",
        "STRUCTURED_AUDIT_LOG",
        "ASYNC_TASK_STATUS",
        "AZURE_QUEUE_PEEK",
        "AZURE_BLOB_OBJECT"
      ],
      "title": "ObserverType",
      "type": "string"
    },
    "OwnerApiLocator": {
      "additionalProperties": false,
      "properties": {
        "locator_type": {
          "const": "OWNER_API",
          "default": "OWNER_API",
          "title": "Locator Type",
          "type": "string"
        },
        "relative_path_template": {
          "maxLength": 512,
          "minLength": 2,
          "title": "Relative Path Template",
          "type": "string"
        }
      },
      "required": [
        "relative_path_template"
      ],
      "title": "OwnerApiLocator",
      "type": "object"
    },
    "QueuePeekBudget": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "maximum": 3,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_message_bytes": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Max Message Bytes",
          "type": "integer"
        },
        "max_messages": {
          "maximum": 32,
          "minimum": 1,
          "title": "Max Messages",
          "type": "integer"
        },
        "max_total_bytes": {
          "maximum": 262144,
          "minimum": 1,
          "title": "Max Total Bytes",
          "type": "integer"
        },
        "per_request_timeout_us": {
          "maximum": 120000000,
          "minimum": 1,
          "title": "Per Request Timeout Us",
          "type": "integer"
        },
        "retry_interval_us": {
          "maximum": 120000000,
          "minimum": 0,
          "title": "Retry Interval Us",
          "type": "integer"
        }
      },
      "required": [
        "max_messages",
        "max_message_bytes",
        "max_total_bytes",
        "max_attempts",
        "per_request_timeout_us",
        "retry_interval_us"
      ],
      "title": "QueuePeekBudget",
      "type": "object"
    },
    "SqliteQueryLocator": {
      "additionalProperties": false,
      "properties": {
        "database_secret_ref": {
          "pattern": "^env:[A-Z_][A-Z0-9_]{0,63}$",
          "title": "Database Secret Ref",
          "type": "string"
        },
        "locator_type": {
          "const": "READ_ONLY_SQLITE",
          "default": "READ_ONLY_SQLITE",
          "title": "Locator Type",
          "type": "string"
        },
        "query_template_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Query Template Id",
          "type": "string"
        },
        "table_or_view": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Table Or View",
          "type": "string"
        }
      },
      "required": [
        "query_template_id",
        "table_or_view",
        "database_secret_ref"
      ],
      "title": "SqliteQueryLocator",
      "type": "object"
    },
    "StructuredAuditLogLocator": {
      "additionalProperties": false,
      "properties": {
        "allowed_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 6,
          "title": "Allowed Fields",
          "type": "array"
        },
        "authorized_root_ref": {
          "pattern": "^env:[A-Z_][A-Z0-9_]{0,63}$",
          "title": "Authorized Root Ref",
          "type": "string"
        },
        "locator_type": {
          "const": "STRUCTURED_AUDIT_LOG",
          "default": "STRUCTURED_AUDIT_LOG",
          "title": "Locator Type",
          "type": "string"
        },
        "relative_file_pattern": {
          "pattern": "^[a-z][a-z0-9_-]{0,48}\\.jsonl$",
          "title": "Relative File Pattern",
          "type": "string"
        },
        "scan_budget": {
          "$ref": "#/$defs/AuditLogScanBudget"
        }
      },
      "required": [
        "authorized_root_ref",
        "relative_file_pattern",
        "allowed_fields",
        "scan_budget"
      ],
      "title": "StructuredAuditLogLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "correlation": {
      "$ref": "#/$defs/Correlation"
    },
    "phase": {
      "$ref": "#/$defs/ObservationPhase"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/ObserverSpec"
    }
  },
  "required": [
    "spec",
    "correlation",
    "phase"
  ],
  "title": "ObserverInvocation",
  "type": "object"
}
