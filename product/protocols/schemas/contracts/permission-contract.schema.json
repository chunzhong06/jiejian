          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Action Id",
          "type": "string"
        },
        "atomic": {
          "default": true,
          "title": "Atomic",
          "type": "boolean"
        },
        "context": {
          "$ref": "#/$defs/PermissionContext"
