          "maxItems": 256,
          "minItems": 2,
          "title": "Resource Expectations",
          "type": "array"
        },
        "rule_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Rule Id",
          "type": "string"
        },
        "severity": {
          "default": "high",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
