    "ActionDefinition": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Action Id",
          "type": "string"
        },
        "effect_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Effect Ids",
          "type": "array"
        },
        "is_batch": {
          "default": false,
          "title": "Is Batch",
          "type": "boolean"
        },
        "workflow_transition": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkflowTransition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action_id",
        "effect_ids"
      ],
      "title": "ActionDefinition",
      "type": "object"
    },
    "BatchPermissionRule": {
      "additionalProperties": false,
      "properties": {
