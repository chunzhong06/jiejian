{
  "$defs": {
    "BatchAuthorizationMode": {
      "enum": [
        "ALL_ALLOW",
        "ALL_DENY",
        "MIXED_AUTHORIZATION"
      ],
      "title": "BatchAuthorizationMode",
      "type": "string"
    },
    "CoverageDimension": {
      "enum": [
        "ROLE",
        "TENANT",
        "DEPARTMENT",
        "RELATION",
        "WORKFLOW",
        "BULK"
      ],
      "title": "CoverageDimension",
      "type": "string"
    },
    "PermissionContext": {
      "additionalProperties": false,
      "properties": {
        "department_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Department Ids",
          "type": "array"
        },
        "resource_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Resource Ids",
          "type": "array"
        },
        "tenant_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Tenant Ids",
          "type": "array"
        },
        "workflow_states": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Workflow States",
          "type": "array"
        }
      },
      "title": "PermissionContext",
      "type": "object"
    },
    "PermissionExpectation": {
      "enum": [
        "ALLOW",
        "DENY"
      ],
      "title": "PermissionExpectation",
      "type": "string"
    },
    "PermissionMutationCase": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "atomic": {
          "default": false,
          "title": "Atomic",
          "type": "boolean"
        },
        "batch_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/BatchAuthorizationMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "case_id": {
          "pattern": "^case-[0-9a-f]{32}$",
          "title": "Case Id",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/PermissionContext"
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/CoverageDimension"
          },
          "maxItems": 6,
          "title": "Dimensions",
          "type": "array"
        },
        "expectations": {
          "items": {
            "$ref": "#/$defs/PermissionExpectation"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Expectations",
          "type": "array"
        },
        "finding_pre_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Finding Pre Identity",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "relation_paths": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Relation Paths",
          "type": "array"
        },
        "required_observations": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Required Observations",
          "type": "array"
        },
        "resource_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Resource Ids",
          "type": "array"
        },
        "retention_reason": {
          "$ref": "#/$defs/RetentionReason"
        },
        "source_rule_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Source Rule Ids",
          "type": "array"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "fingerprint",
        "finding_pre_identity",
        "source_rule_ids",
        "dimensions",
        "retention_reason",
        "subject_id",
        "action_id",
        "resource_ids",
        "expectations",
        "relation_paths",
        "context",
        "required_observations"
      ],
      "title": "PermissionMutationCase",
      "type": "object"
    },
    "PermissionMutationDescriptor": {
      "additionalProperties": false,
      "properties": {
        "allow_value_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Allow Value Fingerprint",
          "type": "string"
        },
        "changed_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Changed Fields",
          "type": "array"
        },
        "deny_value_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Deny Value Fingerprint",
          "type": "string"
        },
        "dimension": {
          "$ref": "#/$defs/CoverageDimension"
        }
      },
      "required": [
        "dimension",
        "changed_fields",
        "allow_value_fingerprint",
        "deny_value_fingerprint"
      ],
      "title": "PermissionMutationDescriptor",
      "type": "object"
    },
    "PermissionTwin": {
      "additionalProperties": false,
      "properties": {
        "allow_case": {
          "$ref": "#/$defs/PermissionMutationCase"
        },
        "deny_case": {
          "$ref": "#/$defs/PermissionMutationCase"
        },
        "invariant": {
          "$ref": "#/$defs/TwinInvariantSpecification"
        },
        "mutation": {
          "$ref": "#/$defs/PermissionMutationDescriptor"
        },
        "source_rule_id": {
          "title": "Source Rule Id",
          "type": "string"
        },
        "twin_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Twin Fingerprint",
          "type": "string"
        },
        "twin_id": {
          "pattern": "^twin-[0-9a-f]{32}$",
          "title": "Twin Id",
          "type": "string"
        },
        "varied_dimension": {
          "$ref": "#/$defs/CoverageDimension"
        }
      },
      "required": [
        "twin_id",
        "source_rule_id",
        "allow_case",
        "deny_case",
        "varied_dimension",
        "mutation",
        "invariant",
        "twin_fingerprint"
      ],
      "title": "PermissionTwin",
      "type": "object"
    },
    "RetentionReason": {
      "enum": [
        "EXPLICIT_ALLOW_BASELINE",
        "EXPLICIT_DENY_RISK",
        "RECENT_NEIGHBOR",
        "BATCH_AUTHORIZATION"
      ],
      "title": "RetentionReason",
      "type": "string"
    },
    "TwinInvariantSpecification": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "baseline_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Fingerprint",
          "type": "string"
        },
        "effect_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Effect Fingerprint",
          "type": "string"
        },
        "normalization_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Normalization Version",
          "type": "string"
        },
        "observer_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observer Fingerprint",
          "type": "string"
        },
        "resource_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Resource Ids",
          "type": "array"
        },
        "workflow_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workflow Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "resource_ids",
        "workflow_fingerprint",
        "effect_fingerprint",
        "observer_fingerprint",
        "baseline_fingerprint",
        "normalization_version"
      ],
      "title": "TwinInvariantSpecification",
      "type": "object"
    },
    "TwinPlanGap": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/TwinPlanGapCode"
        },
        "deny_case_id": {
          "pattern": "^case-[0-9a-f]{32}$",
          "title": "Deny Case Id",
          "type": "string"
        },
        "detail": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "deny_case_id",
        "code",
        "detail"
      ],
      "title": "TwinPlanGap",
      "type": "object"
    },
    "TwinPlanGapCode": {
      "enum": [
        "MISSING_ALLOW_CONTROL",
        "AMBIGUOUS_ALLOW_CONTROL",
        "MULTIPLE_VARIATIONS",
        "MISSING_INVARIANT"
      ],
      "title": "TwinPlanGapCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage_plan_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Coverage Plan Fingerprint",
      "type": "string"
    },
    "differential_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Differential Fingerprint",
      "type": "string"
    },
    "differential_plan_id": {
      "pattern": "^dplan-[0-9a-f]{32}$",
      "title": "Differential Plan Id",
      "type": "string"
    },
    "gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TwinPlanGap"
      },
      "maxItems": 8192,
      "title": "Gaps",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "twins": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PermissionTwin"
      },
      "maxItems": 8192,
      "title": "Twins",
      "type": "array"
    }
  },
  "required": [
    "differential_plan_id",
    "differential_fingerprint",
    "coverage_plan_fingerprint"
  ],
  "title": "DifferentialExperimentPlan",
  "type": "object"
}
