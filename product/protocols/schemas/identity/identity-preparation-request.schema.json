{
  "$defs": {
    "WebTargetScope": {
      "additionalProperties": false,
      "description": "Web 目标的协议级授权范围。",
      "properties": {
        "allow_private_network": {
          "default": false,
          "title": "Allow Private Network",
          "type": "boolean"
        },
        "allowed_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "allowed_origins": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Origins",
          "type": "array"
        },
        "allowed_ports": {
          "items": {
            "type": "integer"
          },
          "title": "Allowed Ports",
          "type": "array"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "follow_redirects": {
          "const": false,
          "default": false,
          "title": "Follow Redirects",
          "type": "boolean"
        },
        "max_requests": {
          "default": 64,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_response_bytes": {
          "default": 262144,
          "maximum": 4194304,
          "minimum": 1,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "base_url",
        "allowed_origins",
        "allowed_hosts",
        "allowed_ports"
      ],
      "title": "WebTargetScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "identity_id": {
      "pattern": "^tid_[0-9a-f]{32}$",
      "title": "Identity Id",
      "type": "string"
    },
    "preparation_id": {
      "pattern": "^prep_[0-9a-f]{32}$",
      "title": "Preparation Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_scope": {
      "$ref": "#/$defs/WebTargetScope"
    },
    "timeout_us": {
      "default": 900000000,
      "maximum": 3600000000,
      "minimum": 1000000,
      "title": "Timeout Us",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "preparation_id",
    "project_id",
    "identity_id",
    "target_scope"
  ],
  "title": "IdentityPreparationRequest",
  "type": "object"
}
