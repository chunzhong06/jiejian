{
  "$defs": {
    "AuthenticationProfile": {
      "additionalProperties": false,
      "properties": {
        "login_path": {
          "default": "/",
          "pattern": "^/[A-Za-z0-9_/-]{0,510}$",
          "title": "Login Path",
          "type": "string"
        },
        "method": {
          "default": "BROWSER_SESSION",
          "enum": [
            "BROWSER_SESSION",
            "BEARER",
            "API_LOGIN",
            "OAUTH2_CLIENT_CREDENTIALS",
            "OAUTH2_REFRESH"
          ],
          "title": "Method",
          "type": "string"
        },
        "oauth_client_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:/-]{1,256}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oauth Client Id"
        },
        "oauth_scope": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:/ -]{1,512}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oauth Scope"
        },
        "password_field": {
          "default": "password",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Password Field",
          "type": "string"
        },
        "principal_kind": {
          "default": "USER",
          "enum": [
            "USER",
            "SERVICE"
          ],
          "title": "Principal Kind",
          "type": "string"
        },
        "token_path": {
          "default": [
            "token"
          ],
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Token Path",
          "type": "array"
        },
        "username_field": {
          "default": "username",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Username Field",
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/IdentityVerificationConfig"
        }
      },
      "required": [
        "verification"
      ],
      "title": "AuthenticationProfile",
      "type": "object"
    },
    "IdentityVerificationConfig": {
      "additionalProperties": false,
      "properties": {
        "expected_role": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Role"
        },
        "expected_subject": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Expected Subject",
          "type": "string"
        },
        "path": {
          "pattern": "^/[A-Za-z0-9_/-]{0,510}$",
          "title": "Path",
          "type": "string"
        },
        "role_path": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 0,
          "title": "Role Path",
          "type": "array"
        },
        "subject_path": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Subject Path",
          "type": "array"
        }
      },
      "required": [
        "path",
        "subject_path",
        "role_path",
        "expected_subject",
        "expected_role"
      ],
      "title": "IdentityVerificationConfig",
      "type": "object"
    },
    "PreparedCookieRef": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "maxLength": 253,
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "expires_at_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At Us"
        },
        "http_only": {
          "title": "Http Only",
          "type": "boolean"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "same_site": {
          "pattern": "^(STRICT|LAX|NONE)$",
          "title": "Same Site",
          "type": "string"
        },
        "secure": {
          "title": "Secure",
          "type": "boolean"
        },
        "value_secret_ref": {
          "maxLength": 512,
          "pattern": "^cred:jiejian/test-identity/[a-z][a-z0-9_-]{0,63}/tid_[0-9a-f]{32}/[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Value Secret Ref",
          "type": "string"
        }
      },
      "required": [
        "name",
        "domain",
        "path",
        "secure",
        "http_only",
        "same_site",
        "value_secret_ref"
      ],
      "title": "PreparedCookieRef",
      "type": "object"
    },
    "WebTargetScope": {
      "additionalProperties": false,
      "description": "Web 目标的协议级授权范围。",
      "properties": {
        "allow_private_network": {
          "default": false,
          "title": "Allow Private Network",
          "type": "boolean"
        },
        "allowed_hosts": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Hosts",
          "type": "array"
        },
        "allowed_origins": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Origins",
          "type": "array"
        },
        "allowed_ports": {
          "items": {
            "type": "integer"
          },
          "title": "Allowed Ports",
          "type": "array"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "follow_redirects": {
          "const": false,
          "default": false,
          "title": "Follow Redirects",
          "type": "boolean"
        },
        "max_requests": {
          "default": 64,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_response_bytes": {
          "default": 262144,
          "maximum": 4194304,
          "minimum": 1,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 5.0,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "base_url",
        "allowed_origins",
        "allowed_hosts",
        "allowed_ports"
      ],
      "title": "WebTargetScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authentication": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthenticationProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "existing_bearer_ref": {
      "anyOf": [
        {
          "pattern": "^cred:jiejian/test-identity/[a-z][a-z0-9_-]{0,63}/tid_[0-9a-f]{32}/[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Existing Bearer Ref"
    },
    "existing_cookies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PreparedCookieRef"
      },
      "maxItems": 32,
      "title": "Existing Cookies",
      "type": "array"
    },
    "identity_id": {
      "pattern": "^tid_[0-9a-f]{32}$",
      "title": "Identity Id",
      "type": "string"
    },
    "preparation_id": {
      "pattern": "^prep_[0-9a-f]{32}$",
      "title": "Preparation Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_prepared_at_us": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Prepared At Us"
    },
    "target_scope": {
      "$ref": "#/$defs/WebTargetScope"
    },
    "timeout_us": {
      "default": 900000000,
      "maximum": 3600000000,
      "minimum": 1000000,
      "title": "Timeout Us",
      "type": "integer"
    },
    "verify_only": {
      "default": false,
      "title": "Verify Only",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "preparation_id",
    "project_id",
    "identity_id",
    "target_scope"
  ],
  "title": "IdentityPreparationRequest",
  "type": "object"
}
