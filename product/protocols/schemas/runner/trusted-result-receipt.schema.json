{
  "additionalProperties": false,
  "description": "Worker 完成协议、工件和当前 fence 校验后的原子标记。",
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "fencing_token": {
      "minimum": 1,
      "title": "Fencing Token",
      "type": "integer"
    },
    "job_id": {
      "pattern": "^job_[0-9a-f]{32}$",
      "title": "Job Id",
      "type": "string"
    },
    "lease_owner": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Lease Owner",
      "type": "string"
    },
    "result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "job_id",
    "attempt",
    "lease_owner",
    "fencing_token",
    "result_sha256"
  ],
  "title": "TrustedResultReceipt",
  "type": "object"
}
