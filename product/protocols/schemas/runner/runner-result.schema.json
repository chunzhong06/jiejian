{
  "$defs": {
    "BatchAuthorizationMode": {
      "enum": [
        "ALL_ALLOW",
        "ALL_DENY",
        "MIXED_AUTHORIZATION"
      ],
      "title": "BatchAuthorizationMode",
      "type": "string"
    },
    "BusinessEffectKind": {
      "enum": [
        "STATE_MUTATION",
        "DATA_DISCLOSURE",
        "OBJECT_CREATION",
        "EXTERNAL_DISPATCH",
        "RESTRICTED_FUNCTION_INVOCATION",
        "CREDENTIAL_ACCESS"
      ],
      "title": "BusinessEffectKind",
      "type": "string"
    },
    "CaseVerdict": {
      "enum": [
        "SAFE",
        "VULNERABLE",
        "INCONCLUSIVE",
        "SKIPPED",
        "ERROR"
      ],
      "title": "CaseVerdict",
      "type": "string"
    },
    "CausalityStatus": {
      "enum": [
        "CORRELATED",
        "UNVERIFIED"
      ],
      "title": "CausalityStatus",
      "type": "string"
    },
    "CleanupIssue": {
      "additionalProperties": false,
      "description": "一个清理问题及其可选稳定底层原因。",
      "properties": {
        "cause_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cause Code"
        },
        "code": {
          "$ref": "#/$defs/CleanupIssueCode"
        }
      },
      "required": [
        "code"
      ],
      "title": "CleanupIssue",
      "type": "object"
    },
    "CleanupIssueCode": {
      "description": "不覆盖主错误的有限清理问题类型。",
      "enum": [
        "POST_CASE_RECOVERY_FAILED",
        "IDENTITY_CLOSE_FAILED",
        "RUNTIME_CLOSE_FAILED",
        "PROCESS_TREE_CLEANUP_FAILED"
      ],
      "title": "CleanupIssueCode",
      "type": "string"
    },
    "CleanupResult": {
      "additionalProperties": false,
      "description": "独立于主错误的现场恢复与资源关闭结果。",
      "properties": {
        "finished_at_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At Us"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CleanupIssue"
          },
          "maxItems": 64,
          "title": "Issues",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/CleanupStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "CleanupResult",
      "type": "object"
    },
    "CleanupStatus": {
      "enum": [
        "NOT_REQUIRED",
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "CleanupStatus",
      "type": "string"
    },
    "Correlation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "request_marker": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Request Marker",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "resource_id",
        "request_marker"
      ],
      "title": "Correlation",
      "type": "object"
    },
    "CoverageDimension": {
      "enum": [
        "ROLE",
        "TENANT",
        "DEPARTMENT",
        "RELATION",
        "WORKFLOW",
        "BULK"
      ],
      "title": "CoverageDimension",
      "type": "string"
    },
    "DisclosureProof": {
      "additionalProperties": false,
      "properties": {
        "correlation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Correlation Digest",
          "type": "string"
        },
        "matched": {
          "title": "Matched",
          "type": "boolean"
        },
        "owner_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Owner Digest",
          "type": "string"
        },
        "projection_complete": {
          "title": "Projection Complete",
          "type": "boolean"
        },
        "projection_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Projection Version",
          "type": "string"
        },
        "response_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Digest",
          "type": "string"
        }
      },
      "required": [
        "projection_version",
        "projection_complete",
        "owner_digest",
        "response_digest",
        "matched",
        "correlation_digest"
      ],
      "title": "DisclosureProof",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "allow_control_valid": {
          "title": "Allow Control Valid",
          "type": "boolean"
        },
        "baseline_integrity": {
          "title": "Baseline Integrity",
          "type": "boolean"
        },
        "case_snapshot": {
          "$ref": "#/$defs/PermissionMutationCase"
        },
        "evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Hash",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^ev_[0-9a-f]{20}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "execution_fact": {
          "$ref": "#/$defs/ExecutionFact"
        },
        "finding_pre_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Finding Pre Identity",
          "type": "string"
        },
        "observation_facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservationFact"
          },
          "maxItems": 19200,
          "title": "Observation Facts",
          "type": "array"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservationEnvelope"
          },
          "maxItems": 19200,
          "title": "Observations",
          "type": "array"
        },
        "outcomes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObserverOutcome"
          },
          "maxItems": 64,
          "title": "Outcomes",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Reason Codes",
          "type": "array"
        },
        "requirement_bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObserverRequirementBinding"
          },
          "maxItems": 16,
          "title": "Requirement Bindings",
          "type": "array"
        },
        "run_id": {
          "pattern": "^run_[0-9a-f]{32}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "security_effect_facts": {
          "items": {
            "$ref": "#/$defs/SecurityEffectFact"
          },
          "maxItems": 19200,
          "minItems": 1,
          "title": "Security Effect Facts",
          "type": "array"
        },
        "twin_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/TwinExecutionRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "twin_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionTwin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verdict": {
          "$ref": "#/$defs/CaseVerdict"
        }
      },
      "required": [
        "evidence_id",
        "run_id",
        "case_snapshot",
        "allow_control_valid",
        "baseline_integrity",
        "finding_pre_identity",
        "execution_fact",
        "security_effect_facts",
        "verdict",
        "evidence_hash"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExecutionFact": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Action Id",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "execution_marker": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Execution Marker",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ExecutionOutcome"
        },
        "output_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reason Codes",
          "type": "array"
        },
        "target_type": {
          "$ref": "#/$defs/TargetType"
        }
      },
      "required": [
        "case_id",
        "action_id",
        "target_type",
        "outcome",
        "execution_marker",
        "input_hash",
        "output_hash"
      ],
      "title": "ExecutionFact",
      "type": "object"
    },
    "ExecutionOutcome": {
      "enum": [
        "ACCEPTED",
        "DENIED",
        "FAILED",
        "UNKNOWN"
      ],
      "title": "ExecutionOutcome",
      "type": "string"
    },
    "JobState": {
      "enum": [
        "PENDING",
        "RUNNING",
        "RETRY_WAIT",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "JobState",
      "type": "string"
    },
    "NormalizedState": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "maximum": 262144,
          "minimum": 2,
          "title": "Byte Count",
          "type": "integer"
        },
        "canonical_data": {
          "additionalProperties": true,
          "title": "Canonical Data",
          "type": "object"
        },
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        }
      },
      "required": [
        "canonical_data",
        "canonical_sha256",
        "byte_count"
      ],
      "title": "NormalizedState",
      "type": "object"
    },
    "ObservationCompleteness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "MISSING",
        "TIMED_OUT",
        "UNSUPPORTED",
        "ERROR"
      ],
      "title": "ObservationCompleteness",
      "type": "string"
    },
    "ObservationEnvelope": {
      "additionalProperties": false,
      "properties": {
        "causality": {
          "$ref": "#/$defs/CausalityStatus"
        },
        "completeness": {
          "$ref": "#/$defs/ObservationCompleteness"
        },
        "correlation": {
          "$ref": "#/$defs/Correlation"
        },
        "observer_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Observer Id",
          "type": "string"
        },
        "observer_type": {
          "$ref": "#/$defs/ObserverType"
        },
        "phase": {
          "$ref": "#/$defs/ObservationPhase"
        },
        "protocol_version": {
          "const": "3",
          "default": "3",
          "title": "Protocol Version",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reason Codes",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/NormalizedState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Target Id",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/ObservationWindow"
        }
      },
      "required": [
        "observer_id",
        "observer_type",
        "phase",
        "target_id",
        "window",
        "correlation",
        "causality",
        "completeness"
      ],
      "title": "ObservationEnvelope",
      "type": "object"
    },
    "ObservationFact": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "correlated": {
          "title": "Correlated",
          "type": "boolean"
        },
        "effect": {
          "$ref": "#/$defs/ObservedEffect"
        },
        "effect_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Effect Id",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reason Codes",
          "type": "array"
        },
        "reliable": {
          "title": "Reliable",
          "type": "boolean"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Resource Id",
          "type": "string"
        },
        "temporal_closure": {
          "$ref": "#/$defs/TemporalClosure"
        }
      },
      "required": [
        "effect_id",
        "requirement_id",
        "resource_id",
        "effect",
        "complete",
        "reliable",
        "correlated",
        "temporal_closure"
      ],
      "title": "ObservationFact",
      "type": "object"
    },
    "ObservationPhase": {
      "enum": [
        "INITIAL",
        "BASELINE",
        "BEFORE",
        "AFTER",
        "EVENTUAL"
      ],
      "title": "ObservationPhase",
      "type": "string"
    },
    "ObservationProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Adapter Version",
          "type": "string"
        },
        "provenance_type": {
          "$ref": "#/$defs/ProvenanceType"
        },
        "query_template_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Template Id"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "provenance_type",
        "adapter_version",
        "target_id",
        "source_sha256"
      ],
      "title": "ObservationProvenance",
      "type": "object"
    },
    "ObservationWindow": {
      "additionalProperties": false,
      "properties": {
        "finished_at_us": {
          "minimum": 0,
          "title": "Finished At Us",
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/ObservationPhase"
        },
        "started_at_us": {
          "minimum": 0,
          "title": "Started At Us",
          "type": "integer"
        },
        "timeout_us": {
          "maximum": 120000000,
          "minimum": 1,
          "title": "Timeout Us",
          "type": "integer"
        }
      },
      "required": [
        "phase",
        "started_at_us",
        "finished_at_us",
        "timeout_us"
      ],
      "title": "ObservationWindow",
      "type": "object"
    },
    "ObservedEffect": {
      "enum": [
        "CONFIRMED",
        "ABSENT",
        "UNKNOWN"
      ],
      "title": "ObservedEffect",
      "type": "string"
    },
    "ObserverOutcome": {
      "additionalProperties": false,
      "properties": {
        "observer_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Observer Id",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reason Codes",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/ObserverOutcomeStatus"
        }
      },
      "required": [
        "observer_id",
        "required",
        "status"
      ],
      "title": "ObserverOutcome",
      "type": "object"
    },
    "ObserverOutcomeStatus": {
      "enum": [
        "AVAILABLE",
        "INCONCLUSIVE",
        "EXECUTION_ERROR"
      ],
      "title": "ObserverOutcomeStatus",
      "type": "string"
    },
    "ObserverRequirementBinding": {
      "additionalProperties": false,
      "properties": {
        "credential_ref": {
          "anyOf": [
            {
              "pattern": "^env:[A-Z][A-Z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Ref"
        },
        "identity_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Id"
        },
        "kind": {
          "$ref": "#/$defs/ObserverRequirementKind"
        },
        "observer_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observer Id"
        },
        "observer_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObserverType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "phases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservationPhase"
          },
          "maxItems": 5,
          "title": "Phases",
          "type": "array"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "kind"
      ],
      "title": "ObserverRequirementBinding",
      "type": "object"
    },
    "ObserverRequirementKind": {
      "enum": [
        "OBSERVER_SPEC"
      ],
      "title": "ObserverRequirementKind",
      "type": "string"
    },
    "ObserverType": {
      "enum": [
        "OWNER_API",
        "READ_ONLY_SQLITE",
        "STRUCTURED_AUDIT_LOG",
        "ASYNC_TASK_STATUS",
        "AZURE_QUEUE_PEEK",
        "AZURE_BLOB_OBJECT"
      ],
      "title": "ObserverType",
      "type": "string"
    },
    "PermissionContext": {
      "additionalProperties": false,
      "properties": {
        "department_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Department Ids",
          "type": "array"
        },
        "resource_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Resource Ids",
          "type": "array"
        },
        "tenant_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Tenant Ids",
          "type": "array"
        },
        "workflow_states": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Workflow States",
          "type": "array"
        }
      },
      "title": "PermissionContext",
      "type": "object"
    },
    "PermissionExpectation": {
      "enum": [
        "ALLOW",
        "DENY"
      ],
      "title": "PermissionExpectation",
      "type": "string"
    },
    "PermissionMutationCase": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "atomic": {
          "default": false,
          "title": "Atomic",
          "type": "boolean"
        },
        "batch_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/BatchAuthorizationMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "case_id": {
          "pattern": "^case-[0-9a-f]{32}$",
          "title": "Case Id",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/PermissionContext"
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/CoverageDimension"
          },
          "maxItems": 6,
          "title": "Dimensions",
          "type": "array"
        },
        "expectations": {
          "items": {
            "$ref": "#/$defs/PermissionExpectation"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Expectations",
          "type": "array"
        },
        "finding_pre_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Finding Pre Identity",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "relation_paths": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Relation Paths",
          "type": "array"
        },
        "required_observations": {
          "items": {
            "type": "string"
