{
  "$defs": {
    "BatchInvocation": {
      "additionalProperties": false,
      "properties": {
        "array_path": {
          "items": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
                "type": "string"
              },
              {
                "maximum": 127,
                "minimum": 0,
                "type": "integer"
              }
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Array Path",
          "type": "array"
        },
        "response_items_path": {
          "anyOf": [
            {
              "pattern": "^\\$(?:\\.[A-Za-z_][A-Za-z0-9_]*|\\[[0-9]+\\]){0,8}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Items Path"
        },
        "response_resource_field": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Resource Field"
        },
        "strategy": {
          "enum": [
            "ATOMIC",
            "PER_ITEM"
          ],
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "array_path"
      ],
      "title": "BatchInvocation",
      "type": "object"
    },
    "BusinessScenarioRevision": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "maxLength": 1024,
          "title": "Description",
          "type": "string"
        },
        "document_type": {
          "const": "jiejian.business-scenario",
          "default": "jiejian.business-scenario",
          "title": "Document Type",
          "type": "string"
        },
        "experiments": {
          "items": {
            "$ref": "#/$defs/ScenarioExperiment"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Experiments",
          "type": "array"
        },
        "id": {
          "pattern": "^bsc_[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "revision",
        "label",
        "experiments"
      ],
      "title": "BusinessScenarioRevision",
      "type": "object"
    },
    "CaseRole": {
      "enum": [
        "ALLOW_REGRESSION",
        "ALLOW_CONTROL",
        "DENY_CHALLENGE"
      ],
      "title": "CaseRole",
      "type": "string"
    },
    "ChangeContext": {
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Change Id",
          "type": "string"
        },
        "impact_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Impact Fingerprint",
          "type": "string"
        },
        "required_intent_ids": {
          "items": {
            "pattern": "^pin_[0-9a-f]{32}$",
            "type": "string"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Required Intent Ids",
          "type": "array"
        }
      },
      "required": [
        "change_id",
        "impact_fingerprint",
        "required_intent_ids"
      ],
      "title": "ChangeContext",
      "type": "object"
    },
    "EffectProofRequirement": {
      "additionalProperties": false,
      "properties": {
        "binding_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binding Fingerprint",
          "type": "string"
        },
        "effect_id": {
          "pattern": "^bef_[0-9a-f]{32}$",
          "title": "Effect Id",
          "type": "string"
        },
        "level": {
          "enum": [
            "VERDICT_REQUIRED",
            "DIAGNOSIS_REQUIRED",
            "SUPPORTING"
          ],
          "title": "Level",
          "type": "string"
        },
        "proof_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Proof Fingerprint",
          "type": "string"
        },
        "reference": {
          "discriminator": {
            "mapping": {
              "OPERATION_HTTP_ENTITY": "#/$defs/OperationProofReference",
              "RECORDED_OBSERVATION": "#/$defs/RecordedProofReference",
              "REGISTERED_OBSERVER": "#/$defs/ObserverProofReference"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RecordedProofReference"
            },
            {
              "$ref": "#/$defs/ObserverProofReference"
            },
            {
              "$ref": "#/$defs/OperationProofReference"
            }
          ],
          "title": "Reference"
        },
        "resource_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "rule": {
          "enum": [
            "HTTP_RESOURCE_PRESENCE",
            "REGISTERED_EFFECT",
            "RECORDED_SUPPORT",
            "HTTP_ENTITY_QUERY"
          ],
          "title": "Rule",
          "type": "string"
        }
      },
      "required": [
        "effect_id",
        "level",
        "rule",
        "binding_fingerprint",
        "resource_id",
        "reference",
        "proof_fingerprint"
      ],
      "title": "EffectProofRequirement",
      "type": "object"
    },
    "ExecutionAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^bac_[0-9a-f]{32}$",
          "title": "Action Id",
          "type": "string"
        },
        "action_revision": {
          "minimum": 1,
          "title": "Action Revision",
          "type": "integer"
        },
        "action_semantic_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Action Semantic Fingerprint",
          "type": "string"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/ExecutionCase"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Cases",
          "type": "array"
        },
        "twins": {
          "items": {
            "$ref": "#/$defs/ExecutionTwin"
          },
          "maxItems": 4096,
          "title": "Twins",
          "type": "array"
        }
      },
      "required": [
        "action_id",
        "action_revision",
        "action_semantic_fingerprint",
        "cases",
        "twins"
      ],
      "title": "ExecutionAction",
      "type": "object"
    },
    "ExecutionAssetReference": {
      "additionalProperties": false,
      "properties": {
        "execution_binding_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Binding Fingerprint",
          "type": "string"
        },
        "flow_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Flow Id",
          "type": "string"
        },
        "flow_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Flow Sha256",
          "type": "string"
        }
      },
      "required": [
        "flow_id",
        "flow_sha256",
        "execution_binding_fingerprint"
      ],
      "title": "ExecutionAssetReference",
      "type": "object"
    },
    "ExecutionCase": {
      "additionalProperties": false,
      "properties": {
        "batch_effect_expectation": {
          "anyOf": [
            {
              "enum": [
                "PRESENT",
                "ABSENT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Effect Expectation"
        },
        "case_id": {
          "pattern": "^case_[0-9a-f]{32}$",
          "title": "Case Id",
          "type": "string"
        },
        "config_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Fingerprint",
          "type": "string"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionAssetReference"
        },
        "invocation_kind": {
          "anyOf": [
            {
              "enum": [
                "BATCH_ATOMIC",
                "BATCH_PER_ITEM"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invocation Kind"
        },
        "occurrence_id": {
          "anyOf": [
            {
              "pattern": "^occ_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence Id"
        },
        "owner_identity_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Owner Identity Fingerprint",
          "type": "string"
        },
        "permission": {
          "$ref": "#/$defs/FrozenPermission"
        },
        "proof_requirements": {
          "items": {
            "$ref": "#/$defs/EffectProofRequirement"
          },
          "maxItems": 48,
          "minItems": 1,
          "title": "Proof Requirements",
          "type": "array"
        },
        "protected_effect_ids": {
          "items": {
            "pattern": "^bef_[0-9a-f]{32}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Protected Effect Ids",
          "type": "array"
        },
        "recovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_binding_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resource Binding Fingerprint",
          "type": "string"
        },
        "resource_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "resource_owner_actor_id": {
          "pattern": "^bar_[0-9a-f]{32}$",
          "title": "Resource Owner Actor Id",
          "type": "string"
        },
        "resource_owner_actor_revision": {
          "minimum": 1,
          "title": "Resource Owner Actor Revision",
          "type": "integer"
        },
        "resource_owner_test_identity_id": {
          "pattern": "^tid_[0-9a-f]{32}$",
          "title": "Resource Owner Test Identity Id",
          "type": "string"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/CaseRole"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "source_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Fingerprint"
        },
        "subject_actor_id": {
          "pattern": "^bar_[0-9a-f]{32}$",
          "title": "Subject Actor Id",
          "type": "string"
        },
        "subject_actor_revision": {
          "minimum": 1,
          "title": "Subject Actor Revision",
          "type": "integer"
        },
        "subject_identity_fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject Identity Fingerprint"
        },
        "subject_test_identity_id": {
          "anyOf": [
            {
              "pattern": "^tid_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subject Test Identity Id"
        }
      },
      "required": [
        "case_id",
        "roles",
        "permission",
        "subject_test_identity_id",
        "subject_actor_id",
        "subject_actor_revision",
        "subject_identity_fingerprint",
        "resource_owner_test_identity_id",
        "resource_owner_actor_id",
        "resource_owner_actor_revision",
        "owner_identity_fingerprint",
        "resource_id",
        "resource_binding_fingerprint",
        "execution",
        "protected_effect_ids",
        "proof_requirements",
        "recovery",
        "source_fingerprint",
        "config_fingerprint"
      ],
      "title": "ExecutionCase",
      "type": "object"
    },
    "ExecutionTwin": {
      "additionalProperties": false,
      "properties": {
        "allow_case_id": {
          "pattern": "^case_[0-9a-f]{32}$",
          "title": "Allow Case Id",
          "type": "string"
        },
        "condition_difference": {
          "anyOf": [
            {
              "const": "RESOURCE_STATE",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Difference"
        },
        "deny_case_id": {
          "pattern": "^case_[0-9a-f]{32}$",
          "title": "Deny Case Id",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "invariants": {
          "$ref": "#/$defs/TwinInvariants"
        },
        "protected_effect_ids": {
          "items": {
            "pattern": "^bef_[0-9a-f]{32}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Protected Effect Ids",
          "type": "array"
        },
        "selected_allow_permission": {
          "$ref": "#/$defs/PermissionReference"
        },
        "twin_id": {
          "pattern": "^twin_[0-9a-f]{32}$",
          "title": "Twin Id",
          "type": "string"
        }
      },
      "required": [
        "twin_id",
        "deny_case_id",
        "allow_case_id",
        "selected_allow_permission",
        "protected_effect_ids",
        "invariants",
        "fingerprint"
      ],
      "title": "ExecutionTwin",
      "type": "object"
    },
    "ExternalRecheckContext": {
      "additionalProperties": false,
      "properties": {
        "deployment_statement": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Deployment Statement",
          "type": "string"
        },
        "source_environment_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Environment Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "source_environment_fingerprint",
        "deployment_statement"
      ],
      "title": "ExternalRecheckContext",
      "type": "object"
    },
    "FrozenBusinessScenario": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "$ref": "#/$defs/BusinessScenarioRevision"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "invocations": {
          "items": {
            "$ref": "#/$defs/FrozenScenarioInvocation"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Invocations",
          "type": "array"
        }
      },
      "required": [
        "document",
        "fingerprint",
        "invocations"
      ],
      "title": "FrozenBusinessScenario",
      "type": "object"
    },
    "FrozenCheckSelection": {
      "additionalProperties": false,
      "properties": {
        "added_controls": {
          "items": {
            "$ref": "#/$defs/PermissionReference"
          },
          "maxItems": 4096,
          "title": "Added Controls",
          "type": "array"
        },
        "omitted": {
          "items": {
            "$ref": "#/$defs/PermissionReference"
          },
          "maxItems": 4096,
          "title": "Omitted",
          "type": "array"
        },
        "pending_review_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20000,
          "title": "Pending Review Ids",
          "type": "array"
        },
        "selected": {
          "items": {
            "$ref": "#/$defs/PermissionReference"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Selected",
          "type": "array"
        },
        "uncovered_requirements": {
          "items": {
            "type": "string"
          },
          "maxItems": 20000,
          "title": "Uncovered Requirements",
          "type": "array"
        }
      },
      "required": [
        "selected",
        "added_controls",
        "omitted",
        "uncovered_requirements",
        "pending_review_ids"
      ],
      "title": "FrozenCheckSelection",
      "type": "object"
    },
    "FrozenEnvironment": {
      "additionalProperties": false,
      "properties": {
        "deployment_label": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deployment Label"
        },
        "deployment_verification": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Deployment Verification",
          "type": "string"
        },
        "environment_id": {
          "pattern": "^env_[0-9a-f]{32}$",
          "title": "Environment Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/WebTargetScope"
        }
      },
      "required": [
        "environment_id",
        "revision",
        "name",
        "target"
      ],
      "title": "FrozenEnvironment",
      "type": "object"
    },
    "FrozenPermission": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionConditions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expectation": {
          "enum": [
            "ALLOW",
            "DENY"
          ],
          "title": "Expectation",
          "type": "string"
        },
        "intent_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Intent Hash",
          "type": "string"
        },
        "intent_id": {
          "pattern": "^pin_[0-9a-f]{32}$",
          "title": "Intent Id",
          "type": "string"
        },
        "protected_effect_ids": {
          "items": {
            "pattern": "^bef_[0-9a-f]{32}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Protected Effect Ids",
          "type": "array"
        },
        "relation": {
          "enum": [
            "OWNS",
            "SAME_ROLE_OTHER_ACCOUNT",
            "OTHER_ROLE"
          ],
          "title": "Relation",
          "type": "string"
        },
        "resource_owner_actor_id": {
          "pattern": "^bar_[0-9a-f]{32}$",
          "title": "Resource Owner Actor Id",
          "type": "string"
        },
        "resource_owner_actor_revision": {
          "minimum": 1,
          "title": "Resource Owner Actor Revision",
          "type": "integer"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "subject_actor_id": {
          "pattern": "^bar_[0-9a-f]{32}$",
          "title": "Subject Actor Id",
          "type": "string"
        },
        "subject_actor_revision": {
          "minimum": 1,
          "title": "Subject Actor Revision",
          "type": "integer"
        }
      },
      "required": [
        "intent_id",
        "revision",
        "intent_hash",
        "expectation",
        "relation",
        "subject_actor_id",
        "subject_actor_revision",
        "resource_owner_actor_id",
        "resource_owner_actor_revision",
        "protected_effect_ids"
      ],
      "title": "FrozenPermission",
      "type": "object"
    },
    "FrozenRequirement": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "IN_SCOPE",
            "PREPARATION",
            "OUT_OF_SCOPE"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/PermissionReference"
          },
          "maxItems": 200,
          "title": "Permissions",
          "type": "array"
        },
        "requirement": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Requirement",
          "type": "string"
        },
        "requirement_id": {
          "pattern": "^req_[0-9a-f]{16}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "time_scope": {
          "enum": [
            "CHECK_WINDOW",
            "HISTORY",
            "NOT_APPLICABLE"
          ],
          "title": "Time Scope",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "requirement",
        "disposition",
        "time_scope",
        "permissions"
      ],
      "title": "FrozenRequirement",
      "type": "object"
    },
    "FrozenRequirementScope": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^rcd_[0-9a-f]{32}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/FrozenRequirement"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "candidate_id",
        "revision",
        "requirements"
      ],
      "title": "FrozenRequirementScope",
      "type": "object"
    },
    "FrozenScenarioInvocation": {
      "additionalProperties": false,
      "properties": {
        "case_ids": {
          "items": {
            "pattern": "^case_[0-9a-f]{32}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Case Ids",
          "type": "array"
        },
        "experiment_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Experiment Id",
          "type": "string"
        },
        "invocation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Invocation Id",
          "type": "string"
        }
      },
      "required": [
        "experiment_id",
        "invocation_id",
        "case_ids"
      ],
      "title": "FrozenScenarioInvocation",
