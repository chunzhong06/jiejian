{
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "completed_cases": {
      "maximum": 8192,
      "minimum": 0,
      "title": "Completed Cases",
      "type": "integer"
    },
    "fencing_token": {
      "minimum": 1,
      "title": "Fencing Token",
      "type": "integer"
    },
    "job_id": {
      "pattern": "^job_[0-9a-f]{32}$",
      "title": "Job Id",
      "type": "string"
    },
    "observed_at_us": {
      "minimum": 0,
      "title": "Observed At Us",
      "type": "integer"
    },
    "phase": {
      "enum": [
        "PREPARING",
        "EXECUTING",
        "FINALIZING"
      ],
      "title": "Phase",
      "type": "string"
    },
    "planned_cases": {
      "maximum": 8192,
      "minimum": 1,
      "title": "Planned Cases",
      "type": "integer"
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "job_id",
    "attempt",
    "fencing_token",
    "request_hash",
    "phase",
    "completed_cases",
    "planned_cases",
    "observed_at_us"
  ],
  "title": "CheckRunnerProgress",
  "type": "object"
}
