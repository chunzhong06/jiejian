{
  "$defs": {
    "BatchAuthorizationMode": {
      "enum": [
        "ALL_ALLOW",
        "ALL_DENY",
        "MIXED_AUTHORIZATION"
      ],
      "title": "BatchAuthorizationMode",
      "type": "string"
    },
    "CaseVerdict": {
      "enum": [
        "SAFE",
        "VULNERABLE",
        "INCONCLUSIVE",
        "SKIPPED",
        "ERROR"
      ],
      "title": "CaseVerdict",
      "type": "string"
    },
    "CausalityStatus": {
      "enum": [
        "CORRELATED",
        "UNVERIFIED"
      ],
      "title": "CausalityStatus",
      "type": "string"
    },
    "Correlation": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "request_marker": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Request Marker",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "resource_id",
        "request_marker"
      ],
      "title": "Correlation",
      "type": "object"
    },
    "CoverageDimension": {
      "enum": [
        "ROLE",
        "TENANT",
        "DEPARTMENT",
        "RELATION",
        "WORKFLOW",
        "BULK"
      ],
      "title": "CoverageDimension",
      "type": "string"
    },
    "DisclosureProof": {
      "additionalProperties": false,
      "properties": {
        "correlation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Correlation Digest",
          "type": "string"
        },
        "matched": {
          "title": "Matched",
          "type": "boolean"
        },
        "owner_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Owner Digest",
          "type": "string"
        },
        "projection_complete": {
          "title": "Projection Complete",
          "type": "boolean"
        },
        "projection_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Projection Version",
          "type": "string"
        },
        "response_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Digest",
          "type": "string"
        }
      },
      "required": [
        "projection_version",
        "projection_complete",
        "owner_digest",
        "response_digest",
        "matched",
        "correlation_digest"
      ],
      "title": "DisclosureProof",
      "type": "object"
    },
    "ExecutionFact": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Action Id",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Case Id",
          "type": "string"
        },
        "execution_marker": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Execution Marker",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ExecutionOutcome"
        },
        "output_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Hash",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reason Codes",
          "type": "array"
        },
        "target_type": {
          "$ref": "#/$defs/TargetType"
        }
      },
      "required": [
        "case_id",
        "action_id",
        "target_type",
        "outcome",
        "execution_marker",
        "input_hash",
        "output_hash"
      ],
      "title": "ExecutionFact",
      "type": "object"
    },
    "ExecutionOutcome": {
      "enum": [
        "ACCEPTED",
        "DENIED",
        "FAILED",
        "UNKNOWN"
      ],
      "title": "ExecutionOutcome",
      "type": "string"
    },
    "NormalizedState": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "maximum": 262144,
          "minimum": 2,
          "title": "Byte Count",
          "type": "integer"
        },
        "canonical_data": {
          "additionalProperties": true,
          "title": "Canonical Data",
          "type": "object"
        },
        "canonical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Sha256",
          "type": "string"
        }
      },
      "required": [
        "canonical_data",
        "canonical_sha256",
        "byte_count"
      ],
      "title": "NormalizedState",
      "type": "object"
    },
    "ObservationCompleteness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "MISSING",
        "TIMED_OUT",
        "UNSUPPORTED",
        "ERROR"
      ],
      "title": "ObservationCompleteness",
      "type": "string"
    },
    "ObservationEnvelope": {
      "additionalProperties": false,
      "properties": {
        "causality": {
          "$ref": "#/$defs/CausalityStatus"
        },
        "completeness": {
          "$ref": "#/$defs/ObservationCompleteness"
        },
        "correlation": {
          "$ref": "#/$defs/Correlation"
        },
        "observer_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Observer Id",
          "type": "string"
        },
        "observer_type": {
          "$ref": "#/$defs/ObserverType"
        },
        "phase": {
          "$ref": "#/$defs/ObservationPhase"
        },
        "protocol_version": {
          "const": "3",
          "default": "3",
          "title": "Protocol Version",
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reason Codes",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/NormalizedState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Target Id",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/ObservationWindow"
        }
      },
      "required": [
        "observer_id",
        "observer_type",
        "phase",
        "target_id",
        "window",
        "correlation",
        "causality",
        "completeness"
      ],
      "title": "ObservationEnvelope",
      "type": "object"
    },
    "ObservationFact": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "correlated": {
          "title": "Correlated",
          "type": "boolean"
        },
        "effect": {
          "$ref": "#/$defs/ObservedEffect"
        },
        "effect_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Effect Id",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reason Codes",
          "type": "array"
        },
        "reliable": {
          "title": "Reliable",
          "type": "boolean"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "resource_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Resource Id",
          "type": "string"
        },
        "temporal_closure": {
          "$ref": "#/$defs/TemporalClosure"
        }
      },
      "required": [
        "effect_id",
        "requirement_id",
        "resource_id",
        "effect",
        "complete",
        "reliable",
        "correlated",
        "temporal_closure"
      ],
      "title": "ObservationFact",
      "type": "object"
    },
    "ObservationPhase": {
      "enum": [
        "INITIAL",
        "BASELINE",
        "BEFORE",
        "AFTER",
        "EVENTUAL"
      ],
      "title": "ObservationPhase",
      "type": "string"
    },
    "ObservationProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Adapter Version",
          "type": "string"
        },
        "provenance_type": {
          "$ref": "#/$defs/ProvenanceType"
        },
        "query_template_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Template Id"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "provenance_type",
        "adapter_version",
        "target_id",
        "source_sha256"
      ],
      "title": "ObservationProvenance",
      "type": "object"
    },
    "ObservationWindow": {
      "additionalProperties": false,
      "properties": {
        "finished_at_us": {
          "minimum": 0,
          "title": "Finished At Us",
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/ObservationPhase"
        },
        "started_at_us": {
          "minimum": 0,
          "title": "Started At Us",
          "type": "integer"
        },
        "timeout_us": {
          "maximum": 120000000,
          "minimum": 1,
          "title": "Timeout Us",
          "type": "integer"
        }
      },
      "required": [
        "phase",
        "started_at_us",
        "finished_at_us",
        "timeout_us"
      ],
      "title": "ObservationWindow",
      "type": "object"
    },
    "ObservedEffect": {
      "enum": [
        "CONFIRMED",
        "ABSENT",
        "UNKNOWN"
      ],
      "title": "ObservedEffect",
      "type": "string"
    },
    "ObserverOutcome": {
      "additionalProperties": false,
      "properties": {
        "observer_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Observer Id",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Reason Codes",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/ObserverOutcomeStatus"
        }
      },
      "required": [
        "observer_id",
        "required",
        "status"
      ],
      "title": "ObserverOutcome",
      "type": "object"
    },
    "ObserverOutcomeStatus": {
      "enum": [
        "AVAILABLE",
        "INCONCLUSIVE",
        "EXECUTION_ERROR"
      ],
      "title": "ObserverOutcomeStatus",
      "type": "string"
    },
    "ObserverRequirementBinding": {
      "additionalProperties": false,
      "properties": {
        "credential_ref": {
          "anyOf": [
            {
              "pattern": "^env:[A-Z][A-Z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Ref"
        },
        "identity_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Id"
        },
        "kind": {
          "$ref": "#/$defs/ObserverRequirementKind"
        },
        "observer_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observer Id"
        },
        "observer_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObserverType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "phases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservationPhase"
          },
          "maxItems": 5,
          "title": "Phases",
          "type": "array"
        },
        "requirement_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "kind"
      ],
      "title": "ObserverRequirementBinding",
      "type": "object"
    },
    "ObserverRequirementKind": {
      "enum": [
        "OBSERVER_SPEC"
      ],
      "title": "ObserverRequirementKind",
      "type": "string"
    },
    "ObserverType": {
      "enum": [
        "OWNER_API",
        "READ_ONLY_SQLITE",
        "STRUCTURED_AUDIT_LOG",
        "ASYNC_TASK_STATUS",
        "AZURE_QUEUE_PEEK",
        "AZURE_BLOB_OBJECT"
      ],
      "title": "ObserverType",
      "type": "string"
    },
    "PermissionContext": {
      "additionalProperties": false,
      "properties": {
        "department_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Department Ids",
          "type": "array"
        },
        "resource_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Resource Ids",
          "type": "array"
        },
        "tenant_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Tenant Ids",
          "type": "array"
        },
        "workflow_states": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Workflow States",
          "type": "array"
        }
      },
      "title": "PermissionContext",
      "type": "object"
    },
    "PermissionExpectation": {
      "enum": [
        "ALLOW",
        "DENY"
      ],
      "title": "PermissionExpectation",
      "type": "string"
    },
    "PermissionMutationCase": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "atomic": {
          "default": false,
          "title": "Atomic",
          "type": "boolean"
        },
        "batch_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/BatchAuthorizationMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "case_id": {
          "pattern": "^case-[0-9a-f]{32}$",
          "title": "Case Id",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/PermissionContext"
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/CoverageDimension"
          },
          "maxItems": 6,
          "title": "Dimensions",
          "type": "array"
        },
        "expectations": {
          "items": {
            "$ref": "#/$defs/PermissionExpectation"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Expectations",
          "type": "array"
        },
        "finding_pre_identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Finding Pre Identity",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "relation_paths": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Relation Paths",
          "type": "array"
        },
        "required_observations": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Required Observations",
          "type": "array"
        },
        "resource_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Resource Ids",
          "type": "array"
        },
        "retention_reason": {
          "$ref": "#/$defs/RetentionReason"
        },
        "source_rule_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Source Rule Ids",
          "type": "array"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "fingerprint",
        "finding_pre_identity",
        "source_rule_ids",
        "dimensions",
        "retention_reason",
        "subject_id",
        "action_id",
        "resource_ids",
        "expectations",
        "relation_paths",
        "context",
        "required_observations"
      ],
      "title": "PermissionMutationCase",
      "type": "object"
    },
    "PermissionMutationDescriptor": {
      "additionalProperties": false,
      "properties": {
        "allow_value_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Allow Value Fingerprint",
          "type": "string"
        },
        "changed_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Changed Fields",
          "type": "array"
        },
        "deny_value_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Deny Value Fingerprint",
          "type": "string"
        },
        "dimension": {
          "$ref": "#/$defs/CoverageDimension"
        }
      },
      "required": [
        "dimension",
        "changed_fields",
        "allow_value_fingerprint",
        "deny_value_fingerprint"
      ],
      "title": "PermissionMutationDescriptor",
      "type": "object"
    },
    "PermissionTwin": {
      "additionalProperties": false,
      "properties": {
        "allow_case": {
          "$ref": "#/$defs/PermissionMutationCase"
        },
        "deny_case": {
          "$ref": "#/$defs/PermissionMutationCase"
        },
        "invariant": {
          "$ref": "#/$defs/TwinInvariantSpecification"
        },
        "mutation": {
          "$ref": "#/$defs/PermissionMutationDescriptor"
        },
        "source_rule_id": {
          "title": "Source Rule Id",
          "type": "string"
        },
        "twin_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Twin Fingerprint",
          "type": "string"
        },
        "twin_id": {
          "pattern": "^twin-[0-9a-f]{32}$",
          "title": "Twin Id",
          "type": "string"
        },
        "varied_dimension": {
          "$ref": "#/$defs/CoverageDimension"
        }
      },
      "required": [
        "twin_id",
        "source_rule_id",
        "allow_case",
        "deny_case",
        "varied_dimension",
        "mutation",
        "invariant",
        "twin_fingerprint"
      ],
      "title": "PermissionTwin",
      "type": "object"
    },
    "ProvenanceType": {
      "enum": [
        "OWNER_API",
        "SQLITE_QUERY",
        "AUDIT_LOG_WINDOW",
        "ASYNC_TASK_API",
        "AZURE_QUEUE_PEEK",
        "AZURE_BLOB_OBJECT"
      ],
      "title": "ProvenanceType",
      "type": "string"
    },
    "RetentionReason": {
      "enum": [
        "EXPLICIT_ALLOW_BASELINE",
        "EXPLICIT_DENY_RISK",
        "RECENT_NEIGHBOR",
        "BATCH_AUTHORIZATION"
      ],
      "title": "RetentionReason",
      "type": "string"
    },
    "SecurityEffectFact": {
      "additionalProperties": false,
      "properties": {
        "baseline_integrity": {
          "title": "Baseline Integrity",
          "type": "boolean"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "correlated": {
          "title": "Correlated",
          "type": "boolean"
        },
        "disclosure_proof": {
          "anyOf": [
            {
              "$ref": "#/$defs/DisclosureProof"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effect_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Effect Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SecurityEffectKind"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Reason Codes",
          "type": "array"
        },
        "reliable": {
          "title": "Reliable",
          "type": "boolean"
        },
        "resource_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Resource Id",
          "type": "string"
        },
        "source_requirement_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Source Requirement Ids",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/ObservedEffect"
        },
        "temporal_closure": {
          "$ref": "#/$defs/TemporalClosure"
        }
      },
      "required": [
        "effect_id",
        "kind",
        "resource_id",
        "state",
        "complete",
        "reliable",
        "correlated",
        "temporal_closure",
        "baseline_integrity",
        "source_requirement_ids"
      ],
      "title": "SecurityEffectFact",
      "type": "object"
    },
    "SecurityEffectKind": {
      "enum": [
        "STATE_MUTATION",
        "DATA_DISCLOSURE",
        "OBJECT_CREATION",
        "EXTERNAL_DISPATCH",
