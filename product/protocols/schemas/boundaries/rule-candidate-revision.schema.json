        "OTHER_ROLE"
      ],
      "title": "PermissionIntentRelation",
      "type": "string"
    },
    "ProposalWriteMode": {
      "enum": [
        "CREATE",
        "REFERENCE",
        "APPEND_REVISION"
      ],
      "title": "ProposalWriteMode",
      "type": "string"
    },
    "ProposedActionItem": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "anyOf": [
            {
              "pattern": "^bac_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "description": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "effect_catalog": {
          "items": {
            "$ref": "#/$defs/ProposedEffectItem"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Effect Catalog",
          "type": "array"
        },
        "effective_state": {
          "$ref": "#/$defs/BusinessRevisionState"
        },
        "expected_current_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Current Revision"
        },
        "item_id": {
          "pattern": "^pactn_[0-9a-f]{16}$",
          "title": "Item Id",
          "type": "string"
        },
        "operation_kind": {
          "$ref": "#/$defs/BusinessActionOperationKind"
        },
        "primary_resource_concept": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Primary Resource Concept",
          "type": "string"
        },
        "source_candidate_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Source Candidate Ids",
          "type": "array"
        },
        "state_changing": {
          "title": "State Changing",
          "type": "boolean"
        },
        "write_mode": {
          "$ref": "#/$defs/ProposalWriteMode"
        }
      },
      "required": [
        "write_mode",
        "item_id",
        "display_name",
        "description",
        "primary_resource_concept",
        "operation_kind",
        "state_changing",
        "effect_catalog",
        "effective_state"
      ],
      "title": "ProposedActionItem",
      "type": "object"
    },
    "ProposedActorItem": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "anyOf": [
            {
              "pattern": "^bar_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Id"
        },
        "description": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "effective_state": {
          "$ref": "#/$defs/BusinessRevisionState"
        },
        "expected_current_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Current Revision"
        },
        "item_id": {
          "pattern": "^pactr_[0-9a-f]{16}$",
          "title": "Item Id",
          "type": "string"
        },
        "source_candidate_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Source Candidate Ids",
          "type": "array"
        },
        "write_mode": {
          "$ref": "#/$defs/ProposalWriteMode"
        }
      },
      "required": [
        "write_mode",
        "item_id",
        "display_name",
        "description",
        "effective_state"
      ],
      "title": "ProposedActorItem",
      "type": "object"
    },
    "ProposedEffectItem": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "protected_projection": {
                "maxItems": 0
              }
            }
          },
          "if": {
            "properties": {
              "effect_kind": {
                "const": "DATA_DISCLOSURE"
              }
            },
            "required": [
              "effect_kind"
            ]
          },
          "then": {
            "properties": {
              "protected_projection": {
                "minItems": 1
              }
            },
            "required": [
              "protected_projection"
            ]
          }
        }
      ],
      "properties": {
        "business_label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Business Label",
          "type": "string"
        },
        "description": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "effect_id": {
          "anyOf": [
            {
              "pattern": "^bef_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Id"
        },
        "effect_kind": {
          "$ref": "#/$defs/BusinessEffectKind"
        },
        "expected_state": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected State"
        },
        "item_id": {
          "pattern": "^peff_[0-9a-f]{16}$",
          "title": "Item Id",
          "type": "string"
        },
        "protected_projection": {
          "default": [],
          "description": "DATA_DISCLOSURE必须填写实际受保护的业务字段；其他效果类型留空。字段来自真实数据含义，不为通过校验编造。",
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Protected Projection",
          "type": "array",
          "uniqueItems": true
        },
        "resource_concept": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Resource Concept",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "business_label",
        "effect_kind",
        "resource_concept",
        "description"
      ],
      "title": "ProposedEffectItem",
      "type": "object"
    },
    "ProposedPermissionItem": {
      "additionalProperties": false,
      "properties": {
        "business_action_item_id": {
          "pattern": "^pactn_[0-9a-f]{16}$",
          "title": "Business Action Item Id",
