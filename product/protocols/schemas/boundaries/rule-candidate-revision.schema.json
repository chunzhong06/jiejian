{
  "$defs": {
    "BoundaryReviewRecord": {
      "additionalProperties": false,
      "properties": {
        "created_at_us": {
          "minimum": 0,
          "title": "Created At Us",
          "type": "integer"
        },
        "decision_id": {
          "pattern": "^brd_[0-9a-f]{32}$",
          "title": "Decision Id",
          "type": "string"
        },
        "expected_basis_id": {
          "pattern": "^rb_[0-9a-f]{64}$",
          "title": "Expected Basis Id",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "issue_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Issue Fingerprint",
          "type": "string"
        },
        "issue_id": {
          "pattern": "^bri_[0-9a-f]{64}$",
          "title": "Issue Id",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Operation Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "NOT_SEPARATE_ACTION",
            "AGENT_OVERINTERPRETATION",
            "REPRESENTED_BY_RULES",
            "BUSINESS_RULE",
            "PREPARATION_DEPENDENCY",
            "EVIDENCE_GAP",
            "COVERAGE_GAP",
            "DEFER"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "output_revision": {
          "minimum": 2,
          "title": "Output Revision",
          "type": "integer"
        },
        "permission_item_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Permission Item Ids",
          "type": "array"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "retained_requirement": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Retained Requirement",
          "type": "string"
        },
        "source": {
          "enum": [
            "unresolved_questions",
            "unsupported_constraints"
          ],
          "title": "Source",
          "type": "string"
        },
        "submitted_via": {
          "const": "LOCAL_GUI",
          "default": "LOCAL_GUI",
          "title": "Submitted Via",
          "type": "string"
        },
        "text": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "expected_basis_id",
        "expected_revision",
        "issue_id",
        "issue_fingerprint",
        "outcome",
        "reason",
        "retained_requirement",
        "decision_id",
        "source",
        "text",
        "output_revision",
        "created_at_us"
      ],
      "title": "BoundaryReviewRecord",
      "type": "object"
    },
    "BusinessActionOperationKind": {
      "enum": [
        "READ",
        "CHANGE",
        "DELETE",
        "EXPORT",
        "ADMIN",
        "CUSTOM"
      ],
      "title": "BusinessActionOperationKind",
      "type": "string"
    },
    "BusinessEffectKind": {
      "enum": [
        "STATE_MUTATION",
        "DATA_DISCLOSURE",
        "FILE_CONTENT_DELIVERY",
        "OBJECT_CREATION",
        "EXTERNAL_DISPATCH",
        "RESTRICTED_FUNCTION_INVOCATION",
        "CREDENTIAL_ACCESS"
      ],
      "title": "BusinessEffectKind",
      "type": "string"
    },
    "BusinessRevisionState": {
      "enum": [
        "ACTIVE",
        "RETIRED"
      ],
      "title": "BusinessRevisionState",
      "type": "string"
    },
    "LegacyRuleCandidateContent": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProposedActionItem"
          },
          "maxItems": 10,
          "title": "Actions",
          "type": "array"
        },
        "actors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProposedActorItem"
          },
          "maxItems": 20,
          "title": "Actors",
          "type": "array"
        },
        "examples": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuleExample"
          },
          "maxItems": 20,
          "title": "Examples",
          "type": "array"
        },
        "original_text": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "permissions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProposedPermissionItem"
          },
          "maxItems": 10,
          "title": "Permissions",
          "type": "array"
        },
        "unresolved_questions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Unresolved Questions",
          "type": "array"
        },
        "unsupported_constraints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Unsupported Constraints",
          "type": "array"
        }
      },
      "required": [
        "original_text"
      ],
      "title": "LegacyRuleCandidateContent",
      "type": "object"
    },
    "LegacyRuleCandidateRevision": {
      "additionalProperties": false,
      "properties": {
        "basis_id": {
          "pattern": "^rb_[0-9a-f]{64}$",
          "title": "Basis Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^rcd_[0-9a-f]{32}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/LegacyRuleCandidateContent"
        },
        "created_at_us": {
          "minimum": 0,
          "title": "Created At Us",
          "type": "integer"
        },
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "submitted_via": {
          "enum": [
            "MCP",
            "LOCAL_GUI"
          ],
          "title": "Submitted Via",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "candidate_id",
        "revision",
        "basis_id",
        "content",
        "submitted_via",
        "created_at_us"
      ],
      "title": "LegacyRuleCandidateRevision",
      "type": "object"
    },
    "PermissionExpectation": {
      "enum": [
        "ALLOW",
        "DENY"
      ],
      "title": "PermissionExpectation",
      "type": "string"
    },
    "PermissionIntentEffectiveState": {
