{
  "$defs": {
    "BoundaryReviewRecord": {
      "additionalProperties": false,
      "properties": {
        "created_at_us": {
          "minimum": 0,
          "title": "Created At Us",
          "type": "integer"
        },
        "decision_id": {
          "pattern": "^brd_[0-9a-f]{32}$",
          "title": "Decision Id",
          "type": "string"
        },
        "expected_basis_id": {
          "pattern": "^rb_[0-9a-f]{64}$",
          "title": "Expected Basis Id",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "issue_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Issue Fingerprint",
          "type": "string"
        },
        "issue_id": {
          "pattern": "^bri_[0-9a-f]{64}$",
          "title": "Issue Id",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Operation Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "NOT_SEPARATE_ACTION",
            "AGENT_OVERINTERPRETATION",
            "REPRESENTED_BY_RULES",
            "BUSINESS_RULE",
            "PREPARATION_DEPENDENCY",
            "EVIDENCE_GAP",
            "COVERAGE_GAP",
            "DEFER"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "output_revision": {
          "minimum": 2,
          "title": "Output Revision",
          "type": "integer"
        },
        "permission_item_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Permission Item Ids",
          "type": "array"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "retained_requirement": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Retained Requirement",
          "type": "string"
        },
        "source": {
          "enum": [
            "unresolved_questions",
            "unsupported_constraints"
          ],
          "title": "Source",
          "type": "string"
        },
        "submitted_via": {
          "const": "LOCAL_GUI",
          "default": "LOCAL_GUI",
          "title": "Submitted Via",
          "type": "string"
        },
        "text": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "expected_basis_id",
        "expected_revision",
        "issue_id",
        "issue_fingerprint",
        "outcome",
        "reason",
        "retained_requirement",
        "decision_id",
        "source",
        "text",
        "output_revision",
        "created_at_us"
      ],
      "title": "BoundaryReviewRecord",
      "type": "object"
    },
    "BusinessActionOperationKind": {
      "enum": [
        "READ",
        "CHANGE",
        "DELETE",
        "EXPORT",
        "ADMIN",
        "CUSTOM"
      ],
      "title": "BusinessActionOperationKind",
      "type": "string"
    },
    "BusinessEffectKind": {
      "enum": [
        "STATE_MUTATION",
        "DATA_DISCLOSURE",
        "FILE_CONTENT_DELIVERY",
        "OBJECT_CREATION",
        "EXTERNAL_DISPATCH",
        "RESTRICTED_FUNCTION_INVOCATION",
        "CREDENTIAL_ACCESS"
      ],
      "title": "BusinessEffectKind",
      "type": "string"
    },
    "BusinessRevisionState": {
      "enum": [
        "ACTIVE",
        "RETIRED"
      ],
      "title": "BusinessRevisionState",
      "type": "string"
    },
    "CoverageDependency": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "issue_id": {
          "pattern": "^bri_[0-9a-f]{64}$",
          "title": "Issue Id",
          "type": "string"
        },
        "output_revision": {
          "minimum": 2,
          "title": "Output Revision",
          "type": "integer"
        }
      },
      "required": [
        "issue_id",
        "output_revision",
        "fingerprint"
      ],
      "title": "CoverageDependency",
      "type": "object"
    },
    "CoverageLink": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "default": false,
          "title": "Complete",
          "type": "boolean"
        },
        "created_at_us": {
          "minimum": 0,
          "title": "Created At Us",
          "type": "integer"
        },
        "expected_basis_id": {
          "pattern": "^rb_[0-9a-f]{64}$",
          "title": "Expected Basis Id",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 1,
          "title": "Expected Revision",
          "type": "integer"
        },
        "issue_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Issue Fingerprint",
          "type": "string"
        },
        "issue_id": {
          "pattern": "^bri_[0-9a-f]{64}$",
          "title": "Issue Id",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Operation Id",
          "type": "string"
        },
        "output_revision": {
          "minimum": 2,
          "title": "Output Revision",
          "type": "integer"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "review_revision": {
          "minimum": 2,
          "title": "Review Revision",
          "type": "integer"
        },
        "submitted_via": {
          "const": "LOCAL_GUI",
          "default": "LOCAL_GUI",
          "title": "Submitted Via",
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/CoverageTarget"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Targets",
          "type": "array"
        },
        "time_scope": {
          "enum": [
            "CHECK_WINDOW",
            "HISTORY"
          ],
          "title": "Time Scope",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "expected_basis_id",
        "expected_revision",
        "issue_id",
        "issue_fingerprint",
        "review_revision",
        "time_scope",
        "targets",
        "reason",
        "output_revision",
        "created_at_us"
      ],
      "title": "CoverageLink",
      "type": "object"
    },
    "CoverageSuggestion": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "issue_id": {
          "pattern": "^bri_[0-9a-f]{64}$",
          "title": "Issue Id",
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/CoverageTarget"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Targets",
          "type": "array"
        },
        "time_scope": {
          "enum": [
            "CHECK_WINDOW",
            "HISTORY"
          ],
          "title": "Time Scope",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "targets",
        "time_scope",
        "explanation"
      ],
      "title": "CoverageSuggestion",
      "type": "object"
    },
    "CoverageTarget": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "pattern": "^/[A-Za-z0-9_./{}-]{1,255}$",
          "title": "Path",
          "type": "string"
        },
        "permission_item_id": {
          "pattern": "^pperm_[0-9a-f]{16}$",
          "title": "Permission Item Id",
          "type": "string"
        },
        "proof": {
          "enum": [
            "EFFECT",
            "PROCESS_RECORD"
          ],
          "title": "Proof",
          "type": "string"
        }
      },
      "required": [
        "permission_item_id",
        "method",
        "path",
        "proof"
      ],
      "title": "CoverageTarget",
      "type": "object"
    },
    "PermissionExpectation": {
      "enum": [
        "ALLOW",
        "DENY"
      ],
      "title": "PermissionExpectation",
      "type": "string"
    },
    "PermissionIntentEffectiveState": {
      "enum": [
        "ACTIVE",
        "RETIRED"
      ],
      "title": "PermissionIntentEffectiveState",
      "type": "string"
    },
    "PermissionIntentRelation": {
      "enum": [
        "OWNS",
        "SAME_ROLE_OTHER_ACCOUNT",
        "OTHER_ROLE"
      ],
      "title": "PermissionIntentRelation",
      "type": "string"
    },
    "ProposalWriteMode": {
      "enum": [
        "CREATE",
        "REFERENCE",
        "APPEND_REVISION"
      ],
      "title": "ProposalWriteMode",
      "type": "string"
    },
    "ProposedActionItem": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "anyOf": [
            {
              "pattern": "^bac_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "description": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "effect_catalog": {
          "items": {
            "$ref": "#/$defs/ProposedEffectItem"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Effect Catalog",
          "type": "array"
        },
        "effective_state": {
          "$ref": "#/$defs/BusinessRevisionState"
        },
        "expected_current_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Current Revision"
        },
        "item_id": {
          "pattern": "^pactn_[0-9a-f]{16}$",
          "title": "Item Id",
          "type": "string"
        },
        "operation_kind": {
          "$ref": "#/$defs/BusinessActionOperationKind"
        },
        "primary_resource_concept": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Primary Resource Concept",
          "type": "string"
        },
        "source_candidate_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Source Candidate Ids",
          "type": "array"
        },
        "state_changing": {
          "title": "State Changing",
          "type": "boolean"
        },
        "write_mode": {
          "$ref": "#/$defs/ProposalWriteMode"
        }
      },
      "required": [
        "write_mode",
        "item_id",
        "display_name",
        "description",
        "primary_resource_concept",
        "operation_kind",
        "state_changing",
        "effect_catalog",
        "effective_state"
      ],
      "title": "ProposedActionItem",
      "type": "object"
    },
    "ProposedActorItem": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "anyOf": [
            {
              "pattern": "^bar_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Id"
        },
        "description": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "effective_state": {
          "$ref": "#/$defs/BusinessRevisionState"
        },
        "expected_current_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Current Revision"
        },
        "item_id": {
          "pattern": "^pactr_[0-9a-f]{16}$",
          "title": "Item Id",
          "type": "string"
        },
        "source_candidate_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Source Candidate Ids",
          "type": "array"
        },
        "write_mode": {
          "$ref": "#/$defs/ProposalWriteMode"
        }
      },
      "required": [
        "write_mode",
        "item_id",
        "display_name",
        "description",
        "effective_state"
      ],
      "title": "ProposedActorItem",
      "type": "object"
    },
    "ProposedEffectItem": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "protected_projection": {
                "maxItems": 0
              }
            }
          },
          "if": {
            "properties": {
              "effect_kind": {
                "const": "DATA_DISCLOSURE"
              }
            },
            "required": [
              "effect_kind"
            ]
          },
          "then": {
            "properties": {
              "protected_projection": {
                "minItems": 1
              }
            },
            "required": [
              "protected_projection"
            ]
          }
        }
      ],
      "properties": {
        "business_label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Business Label",
          "type": "string"
        },
        "description": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "effect_id": {
          "anyOf": [
            {
              "pattern": "^bef_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Id"
        },
        "effect_kind": {
          "$ref": "#/$defs/BusinessEffectKind"
        },
        "expected_state": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected State"
        },
        "item_id": {
          "pattern": "^peff_[0-9a-f]{16}$",
          "title": "Item Id",
          "type": "string"
        },
        "protected_projection": {
          "default": [],
          "description": "DATA_DISCLOSURE必须填写实际受保护的业务字段；其他效果类型留空。字段来自真实数据含义，不为通过校验编造。",
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Protected Projection",
          "type": "array",
          "uniqueItems": true
        },
        "resource_concept": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Resource Concept",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "business_label",
        "effect_kind",
        "resource_concept",
        "description"
      ],
      "title": "ProposedEffectItem",
      "type": "object"
    },
    "ProposedPermissionItem": {
      "additionalProperties": false,
      "properties": {
        "business_action_item_id": {
          "pattern": "^pactn_[0-9a-f]{16}$",
          "title": "Business Action Item Id",
          "type": "string"
        },
        "effective_state": {
          "$ref": "#/$defs/PermissionIntentEffectiveState"
        },
        "expectation": {
          "$ref": "#/$defs/PermissionExpectation"
        },
        "expected_current_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Current Revision"
        },
        "intent_id": {
          "anyOf": [
            {
              "pattern": "^pin_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intent Id"
        },
        "item_id": {
          "pattern": "^pperm_[0-9a-f]{16}$",
          "title": "Item Id",
          "type": "string"
        },
        "protected_effect_item_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Protected Effect Item Ids",
          "type": "array"
        },
        "relation": {
          "$ref": "#/$defs/PermissionIntentRelation"
        },
        "resource_owner_actor_item_id": {
          "pattern": "^pactr_[0-9a-f]{16}$",
          "title": "Resource Owner Actor Item Id",
          "type": "string"
        },
        "subject_actor_item_id": {
          "pattern": "^pactr_[0-9a-f]{16}$",
          "title": "Subject Actor Item Id",
          "type": "string"
        },
        "write_mode": {
          "$ref": "#/$defs/ProposalWriteMode"
        }
      },
      "required": [
        "item_id",
        "write_mode",
        "effective_state",
        "subject_actor_item_id",
        "business_action_item_id",
        "resource_owner_actor_item_id",
        "relation",
        "expectation",
        "protected_effect_item_ids"
      ],
      "title": "ProposedPermissionItem",
      "type": "object"
    },
    "RequirementSource": {
      "additionalProperties": false,
      "properties": {
        "interpretation": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Interpretation",
          "type": "string"
        },
        "origin": {
          "enum": [
            "USER",
            "SOURCE",
            "AGENT"
          ],
          "title": "Origin",
          "type": "string"
        },
        "permission_item_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Permission Item Ids",
          "type": "array"
        },
        "requirement_id": {
          "pattern": "^req_[0-9a-f]{16}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "source_excerpt": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Source Excerpt",
          "type": "string"
        },
        "title": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "title",
        "origin",
        "source_excerpt",
        "interpretation"
      ],
      "title": "RequirementSource",
      "type": "object"
    },
    "ReviewContext": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "pattern": "^brd_[0-9a-f]{32}$",
          "title": "Decision Id",
          "type": "string"
        },
        "dependencies": {
          "$ref": "#/$defs/ReviewDependencies"
        },
        "issue_id": {
          "pattern": "^bri_[0-9a-f]{64}$",
          "title": "Issue Id",
          "type": "string"
        },
        "output_revision": {
          "minimum": 2,
          "title": "Output Revision",
          "type": "integer"
        }
      },
      "required": [
        "issue_id",
        "decision_id",
        "dependencies",
        "output_revision"
      ],
      "title": "ReviewContext",
      "type": "object"
    },
    "ReviewDependencies": {
      "additionalProperties": false,
      "properties": {
        "permission_item_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Permission Item Ids",
          "type": "array"
        },
        "requirement_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        }
      },
      "required": [
        "requirement_ids"
      ],
      "title": "ReviewDependencies",
      "type": "object"
    },
    "RuleExample": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "permission_item_id": {
          "anyOf": [
            {
              "pattern": "^pperm_[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permission Item Id"
        },
        "uncovered_reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncovered Reason"
        }
      },
      "required": [
        "description"
      ],
      "title": "RuleExample",
      "type": "object"
    },
    "RuleScenario": {
      "additionalProperties": false,
      "properties": {
        "occurrence": {
          "default": 1,
          "maximum": 4096,
          "minimum": 1,
          "title": "Occurrence",
          "type": "integer"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/RuleScenarioOption"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "original_excerpt": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Original Excerpt",
          "type": "string"
        },
        "original_text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Text Hash",
          "type": "string"
        },
        "question": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "scenario_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Scenario Fingerprint",
          "type": "string"
        },
        "scenario_id": {
          "pattern": "^rsc_[0-9a-f]{16}$",
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "original_excerpt",
        "question",
        "options",
        "original_text_hash",
        "scenario_fingerprint"
      ],
      "title": "RuleScenario",
      "type": "object"
    },
    "RuleScenarioOption": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "label": {
          "maxLength": 128,
